import { Button, LineEdit, ComboBox, CheckBox, TextEdit, ListView, ScrollView, Palette, Slider } from "std-widgets.slint";

export struct TreeRow { marked: bool, folder: bool, depth: int, expanded: bool, children: bool, name: string, kind: string, detail: string, status: int, favorite: bool }
export struct Field { label: string, value: string }
export struct SessionTab { title: string, kind: string, state: string }
export struct CredRow { name: string, username: string, detail: string }
export struct AvailRow { name: string, path: string, kind: string, endpoint: string, status: int, detail: string }
export struct AuditRow { at: string, user: string, action: string, target: string, detail: string }
export struct WsRow { name: string, detail: string }
// Rendered Markdown block of the notes: kind "h" (depth = level), "p", "li", "code", "table", "quote", "hr".
export struct NoteBlock { kind: string, text: styled-text, plain: string, depth: int, marker: string }
// Generic list row for administration dialogs (attachments, devices, backups…).
export struct ListRow { name: string, detail: string, extra: string, status: int }
// Button of an administration list; needs-selection = disabled until a row is chosen.
export struct AdmAction { label: string, needs-selection: bool }

// Colors of the web version (styles.css), dark and light.
export global Theme {
    in-out property <bool> dark: true;
    out property <color> bg: dark ? #1b1c1f : #f3f4f6;
    out property <color> bg-elev: dark ? #232428 : #ffffff;
    out property <color> bg-panel: dark ? #26272b : #fafafa;
    out property <color> bg-ribbon: dark ? #2b2c31 : #ffffff;
    out property <color> bg-hover: dark ? #33353b : #e8eef7;
    out property <color> bg-input: dark ? #1d1e21 : #ffffff;
    out property <color> bg-title: dark ? #141517 : #e9ebef;
    out property <color> border: dark ? #3a3c42 : #d0d4db;
    out property <color> border-soft: dark ? #2f3136 : #e2e5ea;
    out property <color> text: dark ? #e4e4e7 : #1f2328;
    out property <color> muted: dark ? #9a9ca5 : #646b75;
    out property <color> accent: dark ? #2b7de9 : #1f6fd8;
    out property <color> selection: dark ? #2a4a75 : #cfe2fb;
}

component Ico inherits Image {
    in property <color> tint: Theme.text;
    width: 16px;
    height: 16px;
    colorize: tint;
    accessible-role: none;
}

component KindIcon inherits Image {
    in property <string> kind;
    width: 16px;
    height: 16px;
    accessible-role: none;
    source: kind == "rdp" ? @image-url("icons/monitor.svg") : kind == "ssh" ? @image-url("icons/square-terminal.svg") : kind == "vnc" ? @image-url("icons/screen-share.svg") : kind == "web" ? @image-url("icons/globe.svg") : kind == "pve" ? @image-url("icons/boxes.svg") : kind == "folder-open" ? @image-url("icons/folder-open.svg") : kind == "credential" ? @image-url("icons/key-round.svg") : @image-url("icons/folder.svg");
    colorize: kind == "rdp" ? #3b8eea : kind == "ssh" ? #3fb950 : kind == "vnc" ? #a371f7 : kind == "web" ? #f0883e : kind == "pve" ? #e57000 : kind == "credential" ? #d29922 : #e3b341;
}

// Large ribbon button (.rb-large)
component RbLarge inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <color> tint: Theme.text;
    in property <bool> enabled: true;
    in property <bool> on;
    callback clicked();
    width: max(64px, min(100px, lbl.preferred-width + 14px));
    height: 66px;
    border-radius: 4px;
    border-width: 1px;
    border-color: (ta.has-hover && root.enabled) || root.on ? Theme.border : transparent;
    background: root.on ? Theme.selection : ta.has-hover && root.enabled ? Theme.bg-hover : transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
    VerticalLayout {
        padding-top: 6px;
        padding-left: 4px;
        padding-right: 4px;
        spacing: 4px;
        alignment: start;
        HorizontalLayout {
            alignment: center;
            Ico { source: root.icon; width: 26px; height: 26px; tint: root.enabled ? root.tint : Theme.muted.with-alpha(0.45); }
        }
        lbl := Text {
            text: root.label;
            font-size: 12px;
            horizontal-alignment: center;
            wrap: word-wrap;
            color: root.enabled ? Theme.text : Theme.muted.with-alpha(0.55);
        }
    }
}

// Small ribbon button (.rb-small)
component RbSmall inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <color> tint: Theme.text;
    in property <bool> enabled: true;
    callback clicked();
    height: 21px;
    border-radius: 3px;
    border-width: 1px;
    border-color: ta.has-hover && root.enabled ? Theme.border : transparent;
    background: ta.has-hover && root.enabled ? Theme.bg-hover : transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 5px;
        padding-right: 8px;
        spacing: 6px;
        Ico { source: root.icon; width: 15px; height: 15px; y: 3px; tint: root.enabled ? root.tint : Theme.muted.with-alpha(0.45); }
        Text { text: root.label; font-size: 12px; vertical-alignment: center; color: root.enabled ? Theme.text : Theme.muted.with-alpha(0.55); }
    }
}

// Small icon button of the session tab bar (scroll arrows, list of tabs).
component TabNavButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> enabled: true;
    callback clicked();
    width: 24px;
    background: ta.has-hover && root.enabled ? Theme.bg-hover : transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
    Ico { source: root.icon; width: 15px; height: 15px; tint: root.enabled ? Theme.text : Theme.muted.with-alpha(0.45); }
}

component RbColumn inherits VerticalLayout {
    spacing: 1px;
    alignment: start;
    padding-top: 1px;
}

// Ribbon group with its label (.ribbon-group)
component RGroup inherits HorizontalLayout {
    in property <string> title;
    VerticalLayout {
        padding-left: 6px;
        padding-right: 6px;
        HorizontalLayout {
            spacing: 2px;
            alignment: start;
            vertical-stretch: 1;
            @children
        }
        Text { text: root.title; font-size: 11px; color: Theme.muted; horizontal-alignment: center; }
    }
    Rectangle { width: 1px; background: Theme.border-soft; }
}

component FormRow inherits VerticalLayout {
    in property <string> label;
    spacing: 4px;
    Text { text: root.label; font-size: 12px; color: Theme.muted; }
    @children
}

component Dialog inherits Rectangle {
    in property <string> title;
    in property <string> error;
    in property <string> ok-text: "OK";
    in property <bool> show-ok: true;
    in property <string> cancel-text: "Annuler";

    in property <bool> busy;
    in property <length> card-width: 520px;
    callback ok();
    callback cancel();
    background: #00000099;
    TouchArea { }
    card := Rectangle {
        width: min(root.width - 40px, root.card-width);
        height: min(root.height - 40px, lay.preferred-height);
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        background: Theme.bg-elev;
        border-radius: 6px;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000080;
        lay := VerticalLayout {
            padding: 20px;
            spacing: 12px;
            Text { text: root.title; font-size: 16px; font-weight: 600; color: Theme.text; }
            @children
            if root.error != "": Text { text: root.error; color: #f85149; wrap: word-wrap; }
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                Button { text: root.cancel-text; clicked => { root.cancel(); } }
                if root.show-ok: Button { text: root.busy ? "Patientez…" : root.ok-text; primary: true; enabled: !root.busy; clicked => { root.ok(); } }

            }
        }
    }
}

component StatusDot inherits Rectangle {
    in property <int> status;
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background: status == 1 ? #3fb950 : status == 2 ? #f85149 : Theme.muted.with-alpha(0.5);
}

component SbSep inherits Rectangle {
    width: 1px;
    height: 14px;
    background: #ffffff59;
}

// One line of the SFTP browser and one transfer.
export struct FileRow { name: string, dir: bool, link: bool, size: string, date: string, perms: string }
export struct XferRow { name: string, up: bool, progress: float, detail: string, running: bool, failed: bool }

// Column header of the SFTP browser: click = sort, again = reverse.
component FbHeader inherits Rectangle {
    in property <string> label;
    in property <int> key;
    in property <int> sort;
    in property <bool> desc;
    callback clicked(int);
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(root.key); }
    TouchArea { clicked => { root.clicked(root.key); } }
    HorizontalLayout {
        spacing: 4px;
        Text { text: root.label; font-size: 12px; font-weight: 600; color: Theme.muted; vertical-alignment: center; overflow: elide; }
        if root.sort == root.key: Text { text: root.desc ? "▼" : "▲"; font-size: 9px; color: Theme.muted; vertical-alignment: center; }
    }
}

// SFTP file browser of an SSH session (tab of kind "files").
component FilesView inherits Rectangle {
    in-out property <string> path;
    in property <[FileRow]> rows;
    in-out property <int> selected: -1;
    in property <int> sort;
    in property <bool> desc;
    in property <string> error;
    in property <bool> loading;
    in property <bool> ready;
    in property <bool> drop-hover;
    in property <[XferRow]> xfers;
    callback act(string);
    callback open-row(int);
    callback sort-by(int);
    callback cancel-xfer(int);
    background: Theme.bg;
    fs := FocusScope {
        init => { self.focus(); }
        key-pressed(e) => {
            if (e.text == Key.Return && root.selected >= 0) { root.open-row(root.selected); return accept; }
            if (e.text == Key.Backspace) { root.act("up"); return accept; }
            if (e.text == Key.Delete && root.selected >= 0) { root.act("delete"); return accept; }
            if (e.text == Key.F2 && root.selected >= 0) { root.act("rename"); return accept; }
            if (e.text == Key.UpArrow && root.selected > 0) { root.selected -= 1; return accept; }
            if (e.text == Key.DownArrow && root.selected < root.rows.length - 1) { root.selected += 1; return accept; }
            if (e.text == Key.Home && root.rows.length > 0) { root.selected = 0; return accept; }
            if (e.text == Key.End && root.rows.length > 0) { root.selected = root.rows.length - 1; return accept; }
            reject
        }
        VerticalLayout {
            padding: 8px;
            spacing: 6px;
            HorizontalLayout {
                spacing: 4px;
                height: 28px;
                RbSmall { icon: @image-url("icons/arrow-up.svg"); label: "Parent"; y: 3px; enabled: root.ready && root.path != "/"; clicked => { root.act("up"); } }
                RbSmall { icon: @image-url("icons/refresh-cw.svg"); label: "Actualiser"; y: 3px; enabled: root.ready; clicked => { root.act("refresh"); } }
                path-edit := LineEdit {
                    horizontal-stretch: 1;
                    text <=> root.path;
                    enabled: root.ready;
                    accessible-label: "Chemin";
                    accepted => { root.act("go"); fs.focus(); }
                }
            }
            HorizontalLayout {
                spacing: 4px;
                height: 24px;
                alignment: start;
                RbSmall { icon: @image-url("icons/upload.svg"); label: "Téléverser"; tint: #3fb950; y: 1px; enabled: root.ready; clicked => { root.act("upload"); } }
                RbSmall { icon: @image-url("icons/download.svg"); label: "Télécharger"; tint: #58a6ff; y: 1px; enabled: root.ready && root.selected >= 0 && !root.rows[root.selected].dir; clicked => { root.act("download"); } }
                RbSmall { icon: @image-url("icons/folder-plus.svg"); label: "Nouveau dossier"; tint: #e3b341; y: 1px; enabled: root.ready; clicked => { root.act("mkdir"); } }
                RbSmall { icon: @image-url("icons/pencil.svg"); label: "Renommer"; y: 1px; enabled: root.ready && root.selected >= 0; clicked => { root.act("rename"); } }
                RbSmall { icon: @image-url("icons/trash-2.svg"); label: "Supprimer"; tint: #f85149; y: 1px; enabled: root.ready && root.selected >= 0; clicked => { root.act("delete"); } }
            }
            Rectangle {
                vertical-stretch: 1;
                border-width: root.drop-hover ? 2px : 1px;
                border-color: root.drop-hover ? Theme.accent : Theme.border;
                border-radius: 4px;
                background: root.drop-hover ? Theme.selection.with-alpha(0.35) : Theme.bg-elev;
                VerticalLayout {
                    padding: 1px;
                    HorizontalLayout {
                        height: 26px;
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 10px;
                        Rectangle { width: 16px; }
                        FbHeader { label: "Nom"; key: 0; sort: root.sort; desc: root.desc; horizontal-stretch: 1; clicked(k) => { root.sort-by(k); } }
                        FbHeader { label: "Taille"; key: 1; sort: root.sort; desc: root.desc; width: 80px; clicked(k) => { root.sort-by(k); } }
                        FbHeader { label: "Modifié"; key: 2; sort: root.sort; desc: root.desc; width: 120px; clicked(k) => { root.sort-by(k); } }
                        FbHeader { label: "Droits"; key: 3; sort: root.sort; desc: root.desc; width: 86px; clicked(k) => { root.sort-by(k); } }
                    }
                    Rectangle { height: 1px; background: Theme.border-soft; }
                    if root.error != "" || root.loading || root.rows.length == 0: Text {
                        height: 40px;
                        text: root.loading ? "Chargement…" : root.error != "" ? root.error : "Dossier vide";
                        color: root.error != "" && !root.loading ? #f85149 : Theme.muted;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        wrap: word-wrap;
                    }
                    ListView {
                        vertical-stretch: 1;
                        for r[i] in root.rows: Rectangle {
                            height: 26px;
                            background: i == root.selected ? Theme.selection : row-ta.has-hover ? Theme.bg-hover : transparent;
                            accessible-role: list-item;
                            accessible-label: r.name;
                            accessible-item-selected: i == root.selected;
                            accessible-action-default => { root.selected = i; root.open-row(i); }
                            row-ta := TouchArea {
                                clicked => { root.selected = i; fs.focus(); }
                                double-clicked => { root.selected = i; root.open-row(i); }
                                pointer-event(e) => {
                                    if (e.button == PointerEventButton.right && e.kind == PointerEventKind.down) { root.selected = i; fs.focus(); }
                                }
                            }
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 10px;
                                Ico { source: r.dir ? @image-url("icons/folder.svg") : @image-url("icons/file.svg"); tint: r.dir ? #e3b341 : Theme.muted; y: 5px; }
                                Text { text: r.link ? r.name + "  ↗" : r.name; horizontal-stretch: 1; vertical-alignment: center; overflow: elide; color: Theme.text; }
                                Text { text: r.size; width: 80px; horizontal-alignment: right; vertical-alignment: center; color: Theme.muted; font-size: 12px; }
                                Text { text: r.date; width: 120px; vertical-alignment: center; color: Theme.muted; font-size: 12px; }
                                Text { text: r.perms; width: 86px; vertical-alignment: center; color: Theme.muted; font-size: 12px; font-family: "Consolas"; }
                            }
                        }
                    }
                }
            }
            if root.xfers.length > 0: VerticalLayout {
                spacing: 2px;
                HorizontalLayout {
                    Text { text: "Transferts"; font-size: 12px; font-weight: 600; color: Theme.muted; vertical-alignment: center; horizontal-stretch: 1; }
                    RbSmall { icon: @image-url("icons/x.svg"); label: "Effacer les transferts terminés"; clicked => { root.act("clear"); } }
                }
                for x[i] in root.xfers: HorizontalLayout {
                    height: 24px;
                    spacing: 8px;
                    Ico { source: x.up ? @image-url("icons/upload.svg") : @image-url("icons/download.svg"); tint: x.failed ? #f85149 : x.up ? #3fb950 : #58a6ff; y: 4px; }
                    Text { text: x.name; width: 170px; vertical-alignment: center; overflow: elide; color: Theme.text; font-size: 12px; }
                    Rectangle {
                        horizontal-stretch: 1;
                        min-width: 60px;
                        height: 8px;
                        y: 8px;
                        border-radius: 4px;
                        background: Theme.border-soft;
                        Rectangle {
                            x: 0;
                            width: parent.width * max(0, min(1, x.progress));
                            border-radius: 4px;
                            background: x.failed ? #f85149 : x.running ? Theme.accent : #3fb950;
                        }
                    }
                    Text { text: x.detail; min-width: 120px; horizontal-stretch: 2; vertical-alignment: center; overflow: elide; color: x.failed ? #f85149 : Theme.muted; font-size: 12px; }
                    if x.running: RbSmall { icon: @image-url("icons/ban.svg"); label: "Annuler"; y: 1px; clicked => { root.cancel-xfer(i); } }
                }
            }
            Text {
                text: "Glissez des fichiers depuis l'Explorateur pour les envoyer dans le dossier affiché. Entrée : ouvrir · Retour arrière : parent · F2 : renommer · Suppr : supprimer";
                font-size: 11px;
                color: Theme.muted;
                wrap: word-wrap;
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "Relay";
    icon: @image-url("icon.png");
    preferred-width: 1200px;
    preferred-height: 720px;
    min-width: 860px;
    min-height: 540px;
    default-font-family: "Segoe UI";
    default-font-size: 13px;
    background: Theme.bg;

    in-out property <bool> dark-mode <=> Theme.dark;
    init => { Palette.color-scheme = Theme.dark ? ColorScheme.dark : ColorScheme.light; }
    changed dark-mode => { Palette.color-scheme = Theme.dark ? ColorScheme.dark : ColorScheme.light; }

    in property <[string]> source-names;
    in-out property <int> source-index: -1;
    in property <bool> connected;
    in property <bool> server-mode;
    in property <bool> busy;
    in property <string> status;
    in property <string> user-label;
    in property <string> status-counts;
    in property <string> status-path;
    in property <string> version;
    in-out property <int> rtab: 0;

    in property <[TreeRow]> rows;
    in-out property <int> selected: -1;
    // Row under the pointer while dragging tree rows (-1: root, -2: none).
    in-out property <int> drop-row: -2;
    in property <int> marked-count;
    in property <string> move-title;
    in-out property <int> move-target;
    in-out property <string> search;

    in property <string> detail-kind;
    in property <string> detail-title;
    in property <string> detail-subtitle;
    in property <[Field]> detail-fields;
    in property <string> detail-notes;
    in property <[NoteBlock]> note-blocks;
    in property <[ListRow]> att-rows;
    in-out property <int> att-selected: -1;
    in property <string> att-info;
    in-out property <string> notes-text;
    callback open-link(string);
    in property <string> cmd-targets-text;
    in-out property <string> cmd-text;
    in-out property <bool> cmd-sudo;
    in-out property <string> cmd-timeout: "60";
    in property <[string]> cmd-saved-names;
    in-out property <int> cmd-saved-index;
    in-out property <string> cmd-name;
    in property <[ListRow]> cmd-rows;
    in-out property <int> cmd-selected: -1;
    in property <string> cmd-output;
    in property <string> cmd-summary;
    in property <bool> cmd-retryable;
    in property <bool> cmd-running;
    in-out property <string> bk-password;
    in-out property <string> bk-password2;
    in-out property <string> bk-restore-password;
    in property <string> adm-title;
    in property <string> adm-hint;
    in property <[ListRow]> adm-rows;
    in-out property <int> adm-selected: -1;
    in property <string> adm-detail;
    in property <[AdmAction]> adm-actions;
    in-out property <string> imp-path;
    in-out property <string> imp-root: "Import RDM";
    in property <[string]> imp-cred-names;
    in-out property <int> imp-ssh;
    in-out property <int> imp-rdp;
    in property <string> imp-summary;
    in property <[ListRow]> imp-rows;
    in property <bool> imp-ready;
    in property <bool> can-open;
    in property <bool> can-edit;
    in property <bool> has-entry;
    in property <bool> has-folder;
    in property <bool> can-test;
    in property <bool> is-favorite;
    in property <string> entry-kind;
    // SSH entries targeted by « Exécuter une commande » for the selection.
    in property <int> ctx-ssh;

    in property <[string]> kind-names: ["RDP", "SSH", "VNC", "Web"];
    in property <[string]> credential-names;
    in property <[string]> folder-names;

    // Dialogs: "", "source", "unlock", "entry", "folder", "credential", "confirm", "quick", "creds",
    // "folder-creds", "test", "availability", "audit", "workspaces", "about".
    in-out property <string> dialog;
    in-out property <string> dialog-error;
    in-out property <int> src-type;
    in-out property <string> src-name;
    in-out property <string> src-url;
    in-out property <string> src-token;
    in-out property <string> src-path;
    in-out property <bool> src-create: true;
    in-out property <string> src-password;
    in-out property <string> src-password2;
    in-out property <string> unlock-name;
    in-out property <string> unlock-password;
    in-out property <string> e-title;
    in-out property <string> e-name;
    in-out property <int> e-kind;
    in-out property <string> e-host;
    in-out property <string> e-port;
    in-out property <string> e-url;
    in-out property <string> e-username;
    in-out property <int> e-cred;
    in-out property <int> e-folder;
    in-out property <string> e-notes;
    // NetBox / Proxmox sync source editor.
    in-out property <string> ss-title;
    in-out property <int> ss-kind;
    in-out property <string> ss-name;
    in-out property <string> ss-url;
    in-out property <string> ss-token-id;
    in-out property <string> ss-secret;
    in-out property <bool> ss-has-secret;
    in-out property <bool> ss-verify-tls;
    in-out property <string> ss-interval;
    in-out property <int> ss-ssh-cred;
    in-out property <int> ss-rdp-cred;
    in-out property <bool> ss-opt-a: true;
    in-out property <bool> ss-opt-b: true;
    in property <[string]> ss-cred-names;
    // Options window.
    in-out property <int> o-theme;
    in-out property <bool> o-auto-update;
    in-out property <int> o-font;
    in-out property <string> o-font-size;
    in-out property <bool> o-copy-select;
    // Terminal theme, colouring rules, character set (Options / entry editor).
    in property <[string]> term-theme-names;
    in property <[string]> es-theme-names;
    in property <[string]> charset-names;
    in property <[string]> hl-color-names;
    in-out property <int> o-term-theme;
    in-out property <bool> o-bold-bright: true;
    in-out property <bool> o-highlight;
    in-out property <int> es-charset;
    in-out property <bool> es-send-locale;
    in-out property <int> es-theme;
    in-out property <int> es-highlight;
    in property <[ListRow]> hl-rows;
    in-out property <int> hl-sel: -1;
    in-out property <string> hl-pattern;
    in-out property <bool> hl-regex;
    in-out property <bool> hl-case;
    in-out property <int> hl-fg;
    in-out property <int> hl-bg;
    in-out property <bool> hl-bold;
    in-out property <bool> hl-enabled: true;
    callback hl-act(string);
    in-out property <int> o-rdp-res;
    in-out property <string> o-rdp-width;
    in-out property <string> o-rdp-height;
    // Connection settings of the entry (section "Connexion").
    in-out property <int> e-section;
    in-out property <int> er-res;
    in-out property <string> er-width;
    in-out property <string> er-height;
    in-out property <int> er-depth;
    in-out property <bool> er-multimon;
    in-out property <bool> er-copy: true;
    in-out property <bool> er-paste: true;
    in-out property <bool> er-drives;
    in-out property <bool> er-printers;
    in-out property <int> er-audio;
    in-out property <int> er-keys;
    in-out property <bool> er-console;
    in-out property <int> er-security;
    in-out property <bool> er-ignore-cert;
    in-out property <bool> er-wallpaper;
    in-out property <int> er-gw;
    in-out property <string> er-gw-host;
    in-out property <bool> er-gw-same: true;
    in-out property <int> es-font;
    in-out property <string> es-size;
    in-out property <int> es-scheme;
    in-out property <string> es-scrollback;
    in-out property <string> es-keepalive;
    in-out property <bool> es-agent;
    in-out property <bool> es-sftp: true;
    in-out property <string> es-sftp-root;
    in-out property <int> ev-depth;
    in-out property <bool> ev-read-only;
    in-out property <bool> ev-remote-cursor;
    in-out property <string> es-keyfile;
    in property <[string]> term-font-names: ["Par défaut (Options)", "Consolas", "Cascadia Mono", "Lucida Console", "Courier New"];
    in property <[string]> rdp-res-names: ["Par défaut (Options)", "Adapter à l'onglet", "Taille fixe", "Plein écran"];
    callback pick-key-file();
    in-out property <string> f-title;
    in-out property <string> f-name;
    in-out property <int> f-parent;
    in-out property <string> c-title: "Nouvel identifiant";
    in-out property <string> c-name;
    in-out property <string> c-username;
    in-out property <string> c-domain;
    in-out property <string> c-password;
    in-out property <string> c-totp;
    in-out property <string> c-notes;
    in-out property <int> c-section;
    in-out property <string> c-private-key;
    in-out property <string> c-passphrase;
    in-out property <bool> c-has-private-key;
    in-out property <bool> c-remove-key;
    in-out property <string> confirm-text;
    // Confirm button label ("" = "Supprimer").
    in-out property <string> confirm-ok;
    // Toggled when a native child window (RDP) is hidden, to repaint the area it covered.
    in property <bool> native-flip;
    in-out property <int> q-kind;
    in-out property <string> q-host;
    in-out property <string> q-port;
    in-out property <int> q-cred;
    in-out property <string> q-username;
    in-out property <string> q-password;
    in property <[CredRow]> cred-rows;
    in-out property <int> cred-selected: -1;
    in property <string> cred-info;
    in-out property <int> fc-rdp;
    in-out property <int> fc-ssh;
    in-out property <int> fc-vnc;
    in-out property <int> fc-web;
    in property <string> test-text;
    in property <[AvailRow]> avail-rows;
    in-out property <bool> avail-failed-only;
    in property <[AuditRow]> audit-rows;
    in property <[WsRow]> ws-rows;
    in-out property <int> ws-selected: -1;
    in-out property <string> ws-name;

    in property <[SessionTab]> tabs;
    in-out property <int> active-tab: -1;
    in property <image> term-image;
    in property <string> session-banner;
    in property <bool> session-closed;
    callback reconnect-tab();
    in property <float> scale: 1;

    callback act(string);
    callback source-selected(int);
    callback search-edited(string);
    callback row-selected(int);
    callback row-activated(int);
    callback row-clicked(int, bool, bool);
    callback rows-dropped(int, int);
    callback row-toggled(int);
    callback tree-key(string);
    callback browse-path();
    callback submit-dialog();
    callback cancel-dialog();
    callback cred-selected-changed(int);
    callback tab-activated(int);
    callback tab-closed(int);
    callback console-pointer(float,float,float,float,int);
    callback console-key(string,bool);
    callback term-key(string, bool, bool, bool);
    callback term-size(length, length);
    // kind: 0 down, 1 up, 2 move, 3 cancel; button: 0 left, 1 middle, 2 right, -1 none.
    callback term-mouse(int, int, length, length, bool, bool, bool);
    callback term-wheel(int, length, length, bool);
    in property <string> active-kind;
    // SSH tab whose entry allows SFTP (`sftp` not false).
    in property <bool> active-sftp;
    // The VNC console draws the server's cursor shape itself.
    in property <bool> console-client-cursor;
    // Replay of a server recording (tab of kind "replay").
    in property <bool> rp-playing;
    in property <float> rp-pos;
    in property <string> rp-time;
    in-out property <int> rp-speed: 1;
    callback rp-toggle();
    callback rp-seek(float);
    callback rp-speed-changed(int);
    // SFTP browser of the active "files" tab.
    in-out property <string> fb-path;
    in property <[FileRow]> fb-rows;
    in-out property <int> fb-selected: -1;
    in property <int> fb-sort;
    in property <bool> fb-desc;
    in property <string> fb-error;
    in property <bool> fb-loading;
    in property <bool> fb-ready;
    in property <bool> fb-drop-hover;
    in property <[XferRow]> fb-xfers;
    callback fb-act(string);
    callback fb-open(int);
    callback fb-sort-by(int);
    callback fb-cancel(int);
    // Text prompt (rename, new folder).
    in property <string> prompt-title;
    in property <string> prompt-label;
    in property <string> prompt-ok;
    in-out property <string> prompt-text;
    in property <bool> can-open-external;
    callback open-external();
    // Session area in window coordinates, for native child windows (RDP).
    callback session-area(length, length, length, length);

    callback open-session();
    callback add-source();
    callback remove-source();
    callback refresh();
    callback new-entry();
    callback new-folder();
    callback edit-selected();
    callback delete-selected();
    callback new-credential();
    // In-app updates
    callback check-updates();
    callback update-auto-toggled(bool);
    in-out property <string> upd-state;
    in-out property <string> upd-current;
    in-out property <string> upd-latest;
    in-out property <string> upd-notes;
    in-out property <string> upd-message;
    in-out property <bool> upd-auto: true;

    callback shortcut(string);

    // Window shortcuts: keys not handled by the focused element bubble up here;
    // Ctrl+Tab is taken first, even from a terminal.
    keys := FocusScope {
    init => { self.focus(); }
    capture-key-pressed(e) => {
        if (e.modifiers.control && (e.text == Key.Tab || e.text == Key.Backtab)) {
            root.shortcut(e.modifiers.shift || e.text == Key.Backtab ? "prev-tab" : "next-tab");
            return accept;
        }
        reject
    }
    key-pressed(e) => {
        if (e.modifiers.control && !e.modifiers.alt && (e.text == "f" || e.text == "F")) { search-box.focus(); search-box.select-all(); return accept; }
        if (e.modifiers.control && !e.modifiers.alt && (e.text == "w" || e.text == "W" || e.text == Key.F4)) { root.shortcut("close-tab"); return accept; }
        if (e.text == Key.F5) { root.shortcut("reload"); return accept; }
        reject
    }
    VerticalLayout {
        // Ribbon tabs (.ribbon-tabs)
        Rectangle {
            height: 28px;
            background: Theme.bg-title;
            HorizontalLayout {
                padding-left: 8px;
                spacing: 2px;
                alignment: start;
                for t[i] in ["Accueil", "Affichage", "Administration", "Aide"]: Rectangle {
                    width: tl.preferred-width + 28px;
                    background: root.rtab == i ? Theme.bg-ribbon : transparent;
                    accessible-role: tab;
                    accessible-label: t;
                    accessible-action-default => { root.rtab = i; }
                    TouchArea { clicked => { root.rtab = i; } }
                    tl := Text {
                        width: parent.width;
                        height: parent.height;
                        text: t;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        color: root.rtab == i || tab-hover.has-hover ? Theme.text : Theme.muted;
                    }
                    tab-hover := TouchArea { clicked => { root.rtab = i; } }
                    Rectangle { y: parent.height - 2px; height: 2px; background: root.rtab == i ? Theme.accent : transparent; }
                }
            }
        }
        // Ribbon body (.ribbon-body)
        Rectangle {
            height: 92px;
            background: Theme.bg-ribbon;
            ribbon-sv := ScrollView {
                height: parent.height - 1px;
                content-width: max(self.visible-width, ribbon-content.min-width);
                content-height: self.visible-height;
                // The mouse wheel scrolls the ribbon sideways when the window is too narrow.
                Rectangle {
                    TouchArea {
                        scroll-event(e) => {
                            ribbon-sv.content-x = max(ribbon-sv.visible-width - ribbon-sv.content-width, min(0px, ribbon-sv.content-x + e.delta-y + e.delta-x));
                            accept
                        }
                    }
                ribbon-content := HorizontalLayout {
            if root.rtab == 0: HorizontalLayout {
                padding-left: 6px;
                padding-top: 4px;
                alignment: start;
                RGroup {
                    title: "Session";
                    RbLarge {
                        icon: root.entry-kind == "web" ? @image-url("icons/external-link.svg") : @image-url("icons/play.svg");
                        label: root.entry-kind == "web" ? "Ouvrir le site" : "Ouvrir la session";
                        tint: #3fb950;
                        enabled: root.has-entry;
                        clicked => { root.act("open"); }
                    }
                    RbColumn {
                        RbSmall { icon: @image-url("icons/circle-dot.svg"); label: "Ouvrir et enregistrer"; tint: #f85149; enabled: root.has-entry && root.entry-kind == "ssh"; clicked => { root.act("record"); } }
                        RbSmall { icon: @image-url("icons/activity.svg"); label: "Tester la connexion"; tint: #58a6ff; enabled: root.can-test; clicked => { root.act("test-connection"); } }
                        RbSmall { icon: @image-url("icons/plug-zap.svg"); label: "Connexion rapide"; tint: #e3b341; enabled: root.connected; clicked => { root.act("quick"); } }
                    }
                    RbColumn {
                        RbSmall { icon: @image-url("icons/folder-open.svg"); label: "Espaces de travail"; enabled: root.connected; clicked => { root.act("workspaces"); } }
                        RbSmall { icon: @image-url("icons/folder-open.svg"); label: "Fichiers (SFTP)"; tint: #e3b341; enabled: root.active-sftp; clicked => { root.act("sftp"); } }
                    }
                }
                RGroup {
                    title: "Ajouter";
                    RbLarge { icon: @image-url("icons/plus.svg"); label: "Nouvelle entrée"; tint: #58a6ff; enabled: root.connected; clicked => { root.act("new"); } }
                    RbColumn {
                        RbSmall { icon: @image-url("icons/folder-plus.svg"); label: "Nouveau dossier"; tint: #e3b341; enabled: root.connected; clicked => { root.act("folder"); } }
                        RbSmall { icon: @image-url("icons/monitor.svg"); label: "Entrée RDP"; tint: #3b8eea; enabled: root.connected; clicked => { root.act("new-rdp"); } }
                        RbSmall { icon: @image-url("icons/square-terminal.svg"); label: "Entrée SSH"; tint: #3fb950; enabled: root.connected; clicked => { root.act("new-ssh"); } }
                    }
                }
                RGroup {
                    title: "Édition";
                    RbLarge { icon: @image-url("icons/pencil.svg"); label: "Modifier"; enabled: root.can-edit; clicked => { root.act("edit"); } }
                    RbColumn {
                        RbSmall { icon: @image-url("icons/copy.svg"); label: "Dupliquer"; enabled: root.has-entry && root.can-edit; clicked => { root.act("dup"); } }
                        RbSmall { icon: @image-url("icons/trash-2.svg"); label: "Supprimer"; tint: #f85149; enabled: root.can-edit; clicked => { root.act("del"); } }
                        RbSmall { icon: @image-url("icons/star.svg"); label: root.is-favorite ? "Retirer des favoris" : "Ajouter aux favoris"; tint: #e3b341; enabled: root.has-entry && root.can-edit; clicked => { root.act("fav"); } }
                    }
                }
                RGroup {
                    title: "Commandes";
                    RbLarge { icon: @image-url("icons/zap.svg"); label: "Commande SSH"; tint: #e3b341; enabled: root.connected; clicked => { root.act("cmd"); } }
                }
                RGroup {
                    title: "Coffre";
                    RbLarge { icon: @image-url("icons/key-round.svg"); label: "Identifiants"; tint: #d29922; enabled: root.connected; clicked => { root.act("creds"); } }
                }
                RGroup {
                    title: "Importer";
                    RbLarge { icon: @image-url("icons/file-up.svg"); label: "Importer depuis RDM"; tint: #58a6ff; enabled: root.connected; clicked => { root.act("import"); } }
                }
                RGroup {
                    title: "Données";
                    RbLarge { icon: @image-url("icons/activity.svg"); label: "Disponibilité"; tint: #3fb950; enabled: root.connected; clicked => { root.act("availability"); } }
                    RbColumn {
                        RbSmall { icon: @image-url("icons/refresh-cw.svg"); label: "Actualiser"; enabled: root.connected && !root.busy; clicked => { root.act("reload"); } }
                    }
                }
            }
            if root.rtab == 1: HorizontalLayout {
                padding-left: 6px;
                padding-top: 4px;
                alignment: start;
                RGroup {
                    title: "Thème";
                    RbLarge { icon: @image-url("icons/moon.svg"); label: "Sombre"; on: Theme.dark; clicked => { root.act("dark"); } }
                    RbLarge { icon: @image-url("icons/sun.svg"); label: "Clair"; on: !Theme.dark; clicked => { root.act("light"); } }
                }
                RGroup {
                    title: "Navigation";
                    RbColumn {
                        RbSmall { icon: @image-url("icons/chevrons-up-down.svg"); label: "Tout développer"; clicked => { root.act("expand"); } }
                        RbSmall { icon: @image-url("icons/chevrons-down-up.svg"); label: "Tout réduire"; clicked => { root.act("collapse"); } }
                        RbSmall { icon: @image-url("icons/layout-dashboard.svg"); label: "Tableau de bord"; clicked => { root.act("dash"); } }
                    }
                }
                RGroup {
                    title: "Session";
                    RbLarge { icon: @image-url("icons/maximize.svg"); label: "Plein écran"; tint: #58a6ff; enabled: root.active-kind == "rdp"; clicked => { root.act("fullscreen"); } }
                    RbLarge { icon: @image-url("icons/folder-open.svg"); label: "Fichiers (SFTP)"; tint: #e3b341; enabled: root.active-sftp; clicked => { root.act("sftp"); } }
                    RbLarge { icon: @image-url("icons/shield-check.svg"); label: "Ctrl+Alt+Suppr"; tint: #f85149; enabled: root.active-kind == "rdp" || root.active-kind == "pve"; clicked => { root.act("cad"); } }
                }
            }
            if root.rtab == 2: HorizontalLayout {
                padding-left: 6px;
                padding-top: 4px;
                alignment: start;
                RGroup {
                    title: "Suivi";
                    RbLarge { icon: @image-url("icons/history.svg"); label: "Journal d'activité"; tint: #58a6ff; enabled: root.server-mode; clicked => { root.act("audit"); } }
                    RbLarge { icon: @image-url("icons/film.svg"); label: "Enregistrements"; tint: #58a6ff; enabled: root.server-mode; clicked => { root.act("recordings"); } }
                    RbLarge { icon: @image-url("icons/play.svg"); label: "Lire un enregistrement"; tint: #3fb950; clicked => { root.act("play-cast"); } }
                }
                RGroup {
                    title: "Mobile";
                    RbLarge { icon: @image-url("icons/smartphone.svg"); label: "Appareils"; tint: #3fb950; enabled: root.server-mode; clicked => { root.act("devices"); } }
                }
                RGroup {
                    title: "Synchronisation";
                    RbLarge { icon: @image-url("icons/refresh-cw.svg"); label: "Sources de synchro"; tint: #e57000; enabled: root.server-mode; clicked => { root.act("sources"); } }
                }
                RGroup {
                    title: "Maintenance";
                    RbLarge { icon: @image-url("icons/copy-x.svg"); label: "Doublons"; tint: #d29922; enabled: root.connected; clicked => { root.act("dups"); } }
                    RbLarge { icon: @image-url("icons/hard-drive.svg"); label: "Sauvegarde"; tint: #58a6ff; enabled: root.connected; clicked => { root.act("backups"); } }
                }
                RGroup {
                    title: "Aide";
                    RbLarge { icon: @image-url("icons/sliders-horizontal.svg"); label: "Options"; tint: #58a6ff; clicked => { root.act("options"); } }
                    RbLarge { icon: @image-url("icons/info.svg"); label: "À propos"; clicked => { root.act("about"); } }
                }
            }
            if root.rtab == 3: HorizontalLayout {
                padding-left: 6px;
                padding-top: 4px;
                alignment: start;
                RGroup {
                    title: "Mises à jour";
                    RbLarge { icon: @image-url("icons/download.svg"); label: "Rechercher des mises à jour"; tint: #3fb950; clicked => { root.check-updates(); } }
                }
                RGroup {
                    title: "Aide";
                    RbLarge { icon: @image-url("icons/sliders-horizontal.svg"); label: "Options"; tint: #58a6ff; clicked => { root.act("options"); } }
                    RbLarge { icon: @image-url("icons/info.svg"); label: "À propos"; clicked => { root.act("about"); } }
                }
            }
            }
                }
                }
            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
        }

        HorizontalLayout {
            vertical-stretch: 1;
            // Navigation (.nav)
            Rectangle {
                width: 290px;
                background: Theme.bg-panel;
                VerticalLayout {
                    Rectangle {
                        height: 26px;
                        Text { x: 10px; height: parent.height; text: "NAVIGATION"; font-size: 11px; color: Theme.muted; vertical-alignment: center; }
                        Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border-soft; }
                    }
                    HorizontalLayout {
                        padding: 8px;
                        padding-bottom: 2px;
                        spacing: 4px;
                        Ico { source: @image-url("icons/database.svg"); tint: #58a6ff; width: 14px; height: 14px; y: 9px; }
                        ComboBox {
                            horizontal-stretch: 1;
                            model: root.source-names;
                            current-index <=> root.source-index;
                            enabled: !root.busy;
                            selected => { root.source-selected(self.current-index); }
                        }
                        RbSmall { icon: @image-url("icons/plus.svg"); label: ""; width: 26px; height: 30px; tint: #58a6ff; accessible-label: "Ajouter une source"; clicked => { root.add-source(); } }
                        RbSmall { icon: @image-url("icons/unplug.svg"); label: ""; width: 26px; height: 30px; enabled: root.source-index >= 0; accessible-label: "Retirer la source"; clicked => { root.remove-source(); } }
                    }
                    Text { text: root.user-label; x: 30px; font-size: 11px; color: Theme.muted; overflow: elide; }
                    HorizontalLayout {
                        padding: 8px;
                        padding-top: 4px;
                        spacing: 4px;
                        search-box := LineEdit {
                            placeholder-text: "Rechercher (nom, hôte)…";
                            text <=> root.search;
                            enabled: root.connected;
                            edited(t) => { root.search-edited(t); }
                        }
                    }
                    tree-keys := FocusScope {
                        vertical-stretch: 1;
                        key-pressed(event) => {
                            if (event.text == Key.UpArrow) { root.tree-key("up"); return accept; }
                            if (event.text == Key.DownArrow) { root.tree-key("down"); return accept; }
                            if (event.text == Key.RightArrow) { root.tree-key("right"); return accept; }
                            if (event.text == Key.LeftArrow) { root.tree-key("left"); return accept; }
                            if (event.text == Key.Return) { root.tree-key("enter"); return accept; }
                            if (event.text == Key.Delete) { root.tree-key("delete"); return accept; }
                            if (event.text == Key.F2) { root.tree-key("edit"); return accept; }
                            reject
                        }
                        tree-menu := ContextMenuArea {
                        Menu {
                            if root.has-entry: MenuItem { title: root.marked-count > 1 ? "Ouvrir les entrées sélectionnées (" + root.marked-count + ")" : root.entry-kind == "web" ? "Ouvrir le site" : "Ouvrir la session"; activated => { root.act("open"); } }
                            if root.can-test: MenuItem { title: "Tester la connexion"; activated => { root.act("test-connection"); } }
                            if root.has-entry: MenuItem { title: "Modifier…"; activated => { root.act("edit"); } }
                            if root.has-entry: MenuItem { title: "Dupliquer"; activated => { root.act("dup"); } }
                            if root.has-entry: MenuItem { title: root.is-favorite ? "Retirer des favoris" : "Ajouter aux favoris"; activated => { root.act("fav"); } }
                            if root.has-entry: MenuSeparator { }
                            if root.has-folder: MenuItem { title: "Identifiants du dossier"; activated => { root.act("folder-creds"); } }
                            if !root.has-entry: MenuItem { title: "Voir la disponibilité"; activated => { root.act("availability"); } }
                            if !root.has-entry: MenuSeparator { }
                            if root.ctx-ssh > 0: MenuItem {
                                title: root.ctx-ssh > 1 ? "Exécuter une commande (" + root.ctx-ssh + " serveurs SSH)…" : "Exécuter une commande…";
                                activated => { root.act("cmd"); }
                            }
                            if root.ctx-ssh > 0: MenuSeparator { }
                            MenuItem { title: "Nouvelle entrée…"; activated => { root.act("new"); } }
                            MenuItem { title: "Nouveau dossier…"; activated => { root.act("folder"); } }
                            if root.has-folder: MenuItem { title: "Renommer…"; activated => { root.act("edit"); } }
                            if root.can-edit: MenuSeparator { }
                            if root.can-edit: MenuItem { title: root.marked-count > 1 ? "Supprimer la sélection (" + root.marked-count + ")" : "Supprimer"; activated => { root.act("del"); } }
                            if root.can-edit: MenuItem { title: root.marked-count > 1 ? "Déplacer la sélection vers…" : "Déplacer vers…"; activated => { root.act("move"); } }
                        }
                        // Right-click on the empty part of the tree: menu of the root.
                        TouchArea {
                            enabled: root.connected;
                            pointer-event(e) => {
                                if (e.button == PointerEventButton.right && e.kind == PointerEventKind.down) {
                                    tree-keys.focus();
                                    root.selected = -1;
                                    root.row-selected(-1);
                                    tree-menu.show({ x: self.mouse-x, y: self.mouse-y });
                                }
                            }
                        }
                        ListView {
                            for row[i] in root.rows: Rectangle {
                                height: 24px;
                                background: i == root.selected || row.marked ? Theme.selection : ta.has-hover && root.drop-row == -2 ? Theme.bg-hover : transparent;
                                border-width: i == root.drop-row && row.folder ? 1px : 0;
                                border-color: Theme.accent;
                                accessible-role: list-item;
                                accessible-label: row.name;
                                accessible-item-selected: i == root.selected;
                                accessible-action-default => { root.selected = i; root.row-selected(i); }
                                ta := TouchArea {
                                    // Modifiers of the press, drag in progress (rows moved with the mouse).
                                    property <bool> ctrl;
                                    property <bool> shift;
                                    property <bool> dragging;
                                    property <length> press-y;
                                    mouse-cursor: self.dragging && self.pressed ? MouseCursor.move : MouseCursor.default;
                                    clicked => {
                                        if (self.dragging) { return; }
                                        tree-keys.focus();
                                        if (self.ctrl || self.shift) { root.row-clicked(i, self.ctrl, self.shift); }
                                        else { root.selected = i; root.row-selected(i); }
                                    }
                                    double-clicked => { root.selected = i; root.row-activated(i); }
                                    moved => {
                                        if (self.pressed && !self.dragging && abs(self.mouse-y - self.press-y) > 8px) { self.dragging = true; }
                                        if (self.dragging) {
                                            if (self.mouse-x < 0 || self.mouse-x > self.width) { root.drop-row = -2; }
                                            else {
                                                root.drop-row = i + floor(self.mouse-y / 24px);
                                                if (root.drop-row >= root.rows.length) { root.drop-row = -1; }
                                                if (root.drop-row < -1) { root.drop-row = -2; }
                                            }
                                        }
                                    }
                                    pointer-event(e) => {
                                        if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                                            self.ctrl = e.modifiers.control;
                                            self.shift = e.modifiers.shift;
                                            self.dragging = false;
                                            self.press-y = self.mouse-y;
                                        }
                                        if (e.button == PointerEventButton.left && e.kind == PointerEventKind.up && self.dragging) {
                                            root.rows-dropped(i, root.drop-row);
                                            root.drop-row = -2;
                                        }
                                        if (e.button == PointerEventButton.right && e.kind == PointerEventKind.down) {
                                            tree-keys.focus();
                                            root.selected = i;
                                            root.row-selected(i);
                                            tree-menu.show({
                                                x: self.absolute-position.x - tree-menu.absolute-position.x + self.mouse-x,
                                                y: self.absolute-position.y - tree-menu.absolute-position.y + self.mouse-y,
                                            });
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    padding-left: 6px + row.depth * 16px;
                                    padding-right: 8px;
                                    spacing: 6px;
                                    Rectangle {
                                        width: 14px;
                                        if row.children: Ico {
                                            y: 5px;
                                            width: 14px;
                                            height: 14px;
                                            source: row.expanded ? @image-url("icons/chevron-down.svg") : @image-url("icons/chevron-right.svg");
                                            tint: Theme.muted;
                                        }
                                        TouchArea {
                                            enabled: row.children;
                                            clicked => { root.row-toggled(i); }
                                        }
                                    }
                                    KindIcon { kind: row.kind; y: 4px; }
                                    Text { text: row.name; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; color: Theme.text; }
                                    if row.favorite: Ico { source: @image-url("icons/star.svg"); tint: #e3b341; width: 12px; height: 12px; y: 6px; }
                                    Text { text: row.detail; vertical-alignment: center; horizontal-alignment: right; font-size: 11px; overflow: elide; max-width: 120px; color: Theme.muted; }
                                    if !row.folder && row.kind != "web" && row.kind != "pve": StatusDot { status: row.status; y: 8px; }
                                }
                            }
                        }
                        }
                    }
                }
                Rectangle { x: parent.width - 1px; width: 1px; background: Theme.border; }
            }

            VerticalLayout {
                horizontal-stretch: 1;
                // Document tabs: dashboard + sessions
                Rectangle {
                    height: 32px;
                    background: Theme.bg-panel;
                    HorizontalLayout {
                        padding-left: 4px;
                        spacing: 2px;
                        alignment: start;
                        Rectangle {
                            width: dash-lbl.preferred-width + 44px;
                            background: root.active-tab < 0 ? Theme.bg : dash-ta.has-hover ? Theme.bg-hover : transparent;
                            accessible-role: tab;
                            accessible-label: "Tableau de bord";
                            accessible-action-default => { root.active-tab = -1; root.tab-activated(-1); }
                            dash-ta := TouchArea { clicked => { root.active-tab = -1; root.tab-activated(-1); } }
                            HorizontalLayout {
                                padding-left: 10px;
                                spacing: 6px;
                                Ico { source: @image-url("icons/layout-dashboard.svg"); width: 14px; height: 14px; y: 9px; tint: #58a6ff; }
                                dash-lbl := Text { text: "Tableau de bord"; vertical-alignment: center; color: Theme.text; }
                            }
                            Rectangle { y: parent.height - 2px; height: 2px; background: root.active-tab < 0 ? Theme.accent : transparent; }
                        }
                        // Session tabs scroll horizontally when they overflow
                        // (wheel, arrows, list of all tabs), like RDM.
                        tab-strip := Rectangle {
                            horizontal-stretch: 1;
                            min-width: 0px;
                            clip: true;
                            property <length> nav-w: 76px;
                            property <bool> crowded: tab-row.preferred-width > self.width;
                            property <length> view-w: self.width - (self.crowded ? self.nav-w : 0px);
                            property <length> overflow: self.crowded ? tab-row.preferred-width - self.view-w : 0px;
                            property <length> scroll: 0px;
                            function scroll-by(d: length) { self.scroll = max(0px, min(self.overflow, min(self.scroll, self.overflow) + d)); }
                            function reveal(x: length, w: length) {
                                if (x < self.scroll) { self.scroll = x; }
                                else if (x + w > self.scroll + self.view-w) { self.scroll = x + w - self.view-w; }
                            }
                            TouchArea {
                                scroll-event(e) => {
                                    tab-strip.scroll-by(-(e.delta-y + e.delta-x));
                                    accept
                                }
                            }
                            Flickable {
                                interactive: false;
                                content-width: max(tab-row.preferred-width, self.width);
                                content-x: -min(tab-strip.scroll, tab-strip.overflow);
                                tab-row := HorizontalLayout {
                                    spacing: 2px;
                                    alignment: start;
                                    for t[i] in root.tabs: Rectangle {
                                        property <bool> is-active: root.active-tab == i;
                                        init => { if (self.is-active) { tab-strip.reveal(self.x, self.width); } }
                                        changed is-active => { if (self.is-active) { tab-strip.reveal(self.x, self.width); } }
                                        width: min(240px, tab-lbl.preferred-width + 64px);
                                        background: root.active-tab == i ? Theme.bg : tab-ta.has-hover ? Theme.bg-hover : transparent;
                                        accessible-role: tab;
                                        accessible-label: t.title;
                                        accessible-action-default => { root.active-tab = i; root.tab-activated(i); }
                                        tab-ta := TouchArea {
                                            clicked => { root.active-tab = i; root.tab-activated(i); }
                                            pointer-event(e) => {
                                                if (e.button == PointerEventButton.middle && e.kind == PointerEventKind.up) { root.tab-closed(i); }
                                            }
                                        }
                                        HorizontalLayout {
                                            padding-left: 10px;
                                            padding-right: 4px;
                                            spacing: 6px;
                                            KindIcon { kind: t.kind; y: 8px; }
                                            Rectangle {
                                                width: 7px;
                                                StatusDot { status: t.state == "connected" ? 1 : t.state == "closed" ? 2 : 0; width: 7px; height: 7px; y: 13px; }
                                            }
                                            tab-lbl := Text { text: t.title; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; color: Theme.text; }
                                            Rectangle {
                                                width: 22px;
                                                border-radius: 3px;
                                                background: close-ta.has-hover ? Theme.bg-hover : transparent;
                                                Ico { source: @image-url("icons/x.svg"); width: 13px; height: 13px; tint: Theme.muted; }
                                                close-ta := TouchArea { clicked => { root.tab-closed(i); } }
                                            }
                                        }
                                        Rectangle { y: parent.height - 2px; height: 2px; background: root.active-tab == i ? Theme.accent : transparent; }
                                    }
                                }
                            }
                            // Fade on the left edge when tabs are scrolled out of view.
                            if min(tab-strip.scroll, tab-strip.overflow) > 0: Rectangle {
                                x: 0;
                                width: 28px;
                                background: @linear-gradient(90deg, Theme.bg-panel 0%, Theme.bg-panel 40%, Theme.bg-panel.transparentize(100%) 100%);
                                Rectangle { x: 0; width: 1px; background: Theme.border; }
                            }
                            if tab-strip.crowded: Rectangle {
                                x: parent.width - tab-strip.nav-w;
                                width: tab-strip.nav-w;
                                background: Theme.bg-panel;
                                HorizontalLayout {
                                    spacing: 2px;
                                    padding-left: 2px;
                                    TabNavButton {
                                        icon: @image-url("icons/chevron-left.svg");
                                        label: "Onglets précédents";
                                        enabled: min(tab-strip.scroll, tab-strip.overflow) > 0;
                                        clicked => { tab-strip.scroll-by(-160px); }
                                    }
                                    TabNavButton {
                                        icon: @image-url("icons/chevron-right.svg");
                                        label: "Onglets suivants";
                                        enabled: tab-strip.scroll < tab-strip.overflow;
                                        clicked => { tab-strip.scroll-by(160px); }
                                    }
                                    tab-list-btn := TabNavButton {
                                        icon: @image-url("icons/chevron-down.svg");
                                        label: "Liste des onglets";
                                        clicked => { tab-list.show(); }
                                        tab-list := PopupWindow {
                                            x: parent.width - 280px;
                                            y: parent.height;
                                            width: 280px;
                                            height: min(root.tabs.length * 28px + 8px, 420px);
                                            Rectangle {
                                                background: Theme.bg-elev;
                                                border-width: 1px;
                                                border-color: Theme.border;
                                                border-radius: 4px;
                                                ListView {
                                                    for t[i] in root.tabs: Rectangle {
                                                        height: 28px;
                                                        background: item-ta.has-hover ? Theme.bg-hover : root.active-tab == i ? Theme.bg : transparent;
                                                        accessible-role: list-item;
                                                        accessible-label: t.title;
                                                        accessible-action-default => { root.active-tab = i; root.tab-activated(i); }
                                                        item-ta := TouchArea { clicked => { root.active-tab = i; root.tab-activated(i); } }
                                                        HorizontalLayout {
                                                            padding-left: 10px;
                                                            padding-right: 10px;
                                                            spacing: 8px;
                                                            KindIcon { kind: t.kind; y: 6px; }
                                                            Text { text: t.title; vertical-alignment: center; overflow: elide; color: Theme.text; font-weight: root.active-tab == i ? 600 : 400; }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            if root.active-tab >= 0: session-pane := Rectangle {
                vertical-stretch: 1;
                // Imperceptible change that marks the pane dirty after a native window was hidden.
                background: root.native-flip ? #0c0c0d : #0c0c0c;
                init => { root.session-area(self.absolute-position.x, self.absolute-position.y, self.width, self.height); }
                changed width => { root.session-area(self.absolute-position.x, self.absolute-position.y, self.width, self.height); }
                changed height => { root.session-area(self.absolute-position.x, self.absolute-position.y, self.width, self.height); }
                changed absolute-position => { root.session-area(self.absolute-position.x, self.absolute-position.y, self.width, self.height); }
                if root.active-kind == "rdp": Text {
                    text: "Session Bureau à distance";
                    color: #808080;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                if root.active-kind == "replay": VerticalLayout {
                    height: root.session-banner != "" ? parent.height - 34px : parent.height;
                    y: 0;
                    Image {
                        vertical-stretch: 1;
                        source: root.term-image;
                        image-fit: contain;
                        accessible-role: image;
                        accessible-label: "Enregistrement";
                    }
                    Rectangle {
                        height: 40px;
                        background: Theme.bg-panel;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 10px;
                            Button { text: root.rp-playing ? "Pause" : "Lecture"; width: 90px; height: 28px; y: 6px; clicked => { root.rp-toggle(); } }
                            Slider {
                                horizontal-stretch: 1;
                                minimum: 0;
                                maximum: 1000;
                                value: root.rp-pos;
                                accessible-label: "Position";
                                changed(v) => { root.rp-seek(v); }
                            }
                            Text { text: root.rp-time; color: Theme.text; vertical-alignment: center; font-size: 12px; }
                            ComboBox {
                                width: 80px;
                                height: 28px;
                                y: 6px;
                                model: ["×0,5", "×1", "×2", "×4", "×8"];
                                current-index <=> root.rp-speed;
                                accessible-label: "Vitesse";
                                selected => { root.rp-speed-changed(self.current-index); }
                            }
                        }
                    }
                }
                if root.active-kind == "files": FilesView {
                    height: root.session-banner != "" ? parent.height - 34px : parent.height;
                    y: 0;
                    path <=> root.fb-path;
                    selected <=> root.fb-selected;
                    rows: root.fb-rows;
                    sort: root.fb-sort;
                    desc: root.fb-desc;
                    error: root.fb-error;
                    loading: root.fb-loading;
                    ready: root.fb-ready;
                    drop-hover: root.fb-drop-hover;
                    xfers: root.fb-xfers;
                    act(a) => { root.fb-act(a); }
                    open-row(i) => { root.fb-open(i); }
                    sort-by(k) => { root.fb-sort-by(k); }
                    cancel-xfer(i) => { root.fb-cancel(i); }
                }
                if root.active-kind == "ssh": term-fs := FocusScope {
                    init => { self.focus(); root.term-size(self.width, self.height); }
                    changed width => { root.term-size(self.width, self.height); }
                    changed height => { root.term-size(self.width, self.height); }
                    // Copy / paste keys (Ctrl+C with a selection, Ctrl+V, Shift+Insert…) are handled by term-key.
                    key-pressed(event) => {
                        root.term-key(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift);
                        accept
                    }
                    term-ta := TouchArea {
                        mouse-cursor: text;
                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.down) { term-fs.focus(); }
                            root.term-mouse(
                                e.kind == PointerEventKind.down ? 0 : e.kind == PointerEventKind.up ? 1 : e.kind == PointerEventKind.move ? 2 : 3,
                                e.button == PointerEventButton.left ? 0 : e.button == PointerEventButton.middle ? 1 : e.button == PointerEventButton.right ? 2 : -1,
                                self.mouse-x - 4px, self.mouse-y - 4px, e.modifiers.shift, e.modifiers.control, e.modifiers.alt);
                        }
                        scroll-event(e) => {
                            root.term-wheel(e.delta-y > 0 ? 3 : -3, self.mouse-x - 4px, self.mouse-y - 4px, e.modifiers.shift);
                            accept
                        }
                    }
                    Image {
                        x: 4px;
                        y: 4px;
                        source: root.term-image;
                        width: self.source.width * 1px / root.scale;
                        height: self.source.height * 1px / root.scale;
                        image-rendering: pixelated;
                    }
                }
                if root.active-kind == "pve": console-focus := FocusScope {
                    init => { self.focus(); }
                    key-pressed(e) => { root.console-key(e.text,true); accept }
                    key-released(e) => { root.console-key(e.text,false); accept }
                    Image { source: root.term-image; width: parent.width; height: parent.height - 34px; image-fit: fill; }
                    console-mouse := TouchArea {
                        mouse-cursor: root.console-client-cursor ? MouseCursor.none : MouseCursor.default;
                        height: parent.height - 34px;
                        property <int> buttons: 0;
                        moved => { root.console-pointer(self.mouse-x/1px,self.mouse-y/1px,self.width/1px,self.height/1px,self.buttons); }
                        pointer-event(e) => {
                            console-focus.focus();
                            if e.kind == PointerEventKind.cancel { self.buttons=0; }
                            if e.kind == PointerEventKind.down || e.kind == PointerEventKind.up {
                                // Keep simultaneous mouse buttons pressed.
                                if e.button == PointerEventButton.left { self.buttons += e.kind == PointerEventKind.down ? 1 : -1; }
                                if e.button == PointerEventButton.middle { self.buttons += e.kind == PointerEventKind.down ? 2 : -2; }
                                if e.button == PointerEventButton.right { self.buttons += e.kind == PointerEventKind.down ? 4 : -4; }
                            }
                            root.console-pointer(self.mouse-x/1px,self.mouse-y/1px,self.width/1px,self.height/1px,self.buttons);
                        }
                        scroll-event(e) => {
                            root.console-pointer(self.mouse-x/1px,self.mouse-y/1px,self.width/1px,self.height/1px,self.buttons + (e.delta-y > 0 ? 8 : 16));
                            root.console-pointer(self.mouse-x/1px,self.mouse-y/1px,self.width/1px,self.height/1px,self.buttons);
                            accept
                        }
                    }
                }
                if root.session-banner != "": Rectangle {
                    x: 0;
                    y: parent.height - 34px;
                    height: 34px;
                    background: #1f2328e0;
                    HorizontalLayout {
                        alignment: center;
                        spacing: 12px;
                        padding: 3px;
                        Text { text: root.session-banner; color: #f0f0f0; vertical-alignment: center; overflow: elide; }
                        if root.session-closed: Button { text: "Reconnecter"; primary: true; clicked => { root.reconnect-tab(); } }
                    }
                }
            }
            // Dashboard of the selected item
            if root.active-tab < 0: Rectangle {
                vertical-stretch: 1;
                background: Theme.bg;
                // Same area as the session pane: a new RDP tab starts at the right size.
                init => { root.session-area(self.absolute-position.x, self.absolute-position.y, self.width, self.height); }
                changed width => { root.session-area(self.absolute-position.x, self.absolute-position.y, self.width, self.height); }
                changed height => { root.session-area(self.absolute-position.x, self.absolute-position.y, self.width, self.height); }
                changed absolute-position => { root.session-area(self.absolute-position.x, self.absolute-position.y, self.width, self.height); }
                if root.detail-title == "": VerticalLayout {
                    alignment: center;
                    spacing: 10px;
                    HorizontalLayout { alignment: center; Ico { source: @image-url("icons/layout-dashboard.svg"); width: 44px; height: 44px; tint: Theme.muted.with-alpha(0.5); } }
                    Text {
                        text: root.connected ? "Sélectionnez une entrée ou un dossier." : "Choisissez ou ajoutez une source de données dans le panneau Navigation.";
                        horizontal-alignment: center;
                        color: Theme.muted;
                    }
                }
                // The whole sheet scrolls, so long notes and attachments get the full height.
                if root.detail-title != "": sheet-sv := ScrollView {
                    content-width: self.visible-width;
                    content-height: sheet-lay.preferred-height;
                    sheet-lay := VerticalLayout {
                        width: sheet-sv.visible-width;
                        padding: 22px;
                        spacing: 14px;
                        HorizontalLayout {
                            spacing: 14px;
                            KindIcon { kind: root.detail-kind; width: 36px; height: 36px; }
                            VerticalLayout {
                                alignment: center;
                                Text { text: root.detail-title; font-size: 22px; font-weight: 600; overflow: elide; color: Theme.text; }
                                Text { text: root.detail-subtitle; color: Theme.muted; overflow: elide; }
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            if root.can-open: Button { text: root.entry-kind == "web" ? "Ouvrir le site" : "Ouvrir la session"; primary: true; clicked => { root.act("open"); } }
                            if root.can-test: Button { text: "Tester la connexion"; clicked => { root.act("test-connection"); } }
                            if root.can-edit: Button { text: "Modifier"; clicked => { root.act("edit"); } }
                            if root.has-folder: Button { text: "Identifiants du dossier"; clicked => { root.act("folder-creds"); } }
                            if root.has-folder: Button { text: "Disponibilité"; clicked => { root.act("availability"); } }
                            if root.can-open-external: Button { text: "Ouvrir dans mstsc"; clicked => { root.open-external(); } }

                        }
                        Rectangle {
                            background: Theme.bg-elev;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: Theme.border-soft;
                            VerticalLayout {
                                padding: 14px;
                                spacing: 9px;
                                for f in root.detail-fields: HorizontalLayout {
                                    spacing: 12px;
                                    Text { text: f.label; width: 170px; color: Theme.muted; }
                                    Text { text: f.value; overflow: elide; horizontal-stretch: 1; color: Theme.text; }
                                }
                            }
                        }
                        notes-lay := VerticalLayout {
                            padding-top: 4px;
                            spacing: 8px;
                            if root.has-entry: HorizontalLayout {
                                spacing: 10px;
                                Text { text: "Notes"; font-weight: 600; color: Theme.text; vertical-alignment: center; }
                                Rectangle { horizontal-stretch: 1; }
                                RbSmall { icon: @image-url("icons/pencil.svg"); label: "Modifier les notes"; enabled: root.can-edit; clicked => { root.act("notes-edit"); } }
                            }
                            if root.has-entry && root.note-blocks.length == 0: Text { text: "Aucune note."; color: Theme.muted; font-size: 12px; }
                            for b in root.note-blocks: VerticalLayout {
                                if b.kind == "h": StyledText {
                                    text: b.text;
                                    default-color: Theme.text;
                                    link-color: #58a6ff;
                                    default-font-size: b.depth == 1 ? 20px : b.depth == 2 ? 17px : 15px;
                                    link-clicked(l) => { root.open-link(l); }
                                }
                                if b.kind == "p": StyledText {
                                    text: b.text;
                                    default-color: Theme.text;
                                    link-color: #58a6ff;
                                    link-clicked(l) => { root.open-link(l); }
                                }
                                if b.kind == "li": HorizontalLayout {
                                    padding-left: 4px + b.depth * 18px;
                                    spacing: 6px;
                                    if b.marker == "☐" || b.marker == "☑": VerticalLayout {
                                        alignment: start;
                                        padding-top: 1px;
                                        Ico {
                                            source: b.marker == "☑" ? @image-url("icons/square-check.svg") : @image-url("icons/square.svg");
                                            tint: b.marker == "☑" ? #3fb950 : Theme.muted;
                                        }
                                    }
                                    if b.marker != "☐" && b.marker != "☑": Text { text: b.marker; color: Theme.muted; min-width: 16px; }
                                    StyledText {
                                        horizontal-stretch: 1;
                                        text: b.text;
                                        default-color: Theme.text;
                                        link-color: #58a6ff;
                                        link-clicked(l) => { root.open-link(l); }
                                    }
                                }
                                if b.kind == "quote": HorizontalLayout {
                                    spacing: 10px;
                                    Rectangle { width: 3px; background: Theme.border; }
                                    StyledText {
                                        horizontal-stretch: 1;
                                        text: b.text;
                                        default-color: Theme.muted;
                                        link-color: #58a6ff;
                                        link-clicked(l) => { root.open-link(l); }
                                    }
                                }
                                if b.kind == "code" || b.kind == "table": Rectangle {
                                    background: Theme.bg-panel;
                                    border-radius: 4px;
                                    border-width: 1px;
                                    border-color: Theme.border-soft;
                                    VerticalLayout {
                                        padding: 8px;
                                        Text { text: b.plain; font-family: "Consolas"; font-size: 12px; color: Theme.text; wrap: word-wrap; }
                                    }
                                }
                                if b.kind == "hr": Rectangle { height: 1px; background: Theme.border; }
                            }
                            if root.has-entry: HorizontalLayout {
                                padding-top: 8px;
                                spacing: 10px;
                                Text { text: "Pièces jointes"; font-weight: 600; color: Theme.text; vertical-alignment: center; }
                                Rectangle { horizontal-stretch: 1; }
                                RbSmall { icon: @image-url("icons/plus.svg"); label: "Ajouter…"; tint: #58a6ff; enabled: root.can-edit; clicked => { root.act("att-add"); } }
                                RbSmall { icon: @image-url("icons/download.svg"); label: "Télécharger…"; enabled: root.att-selected >= 0; clicked => { root.act("att-get"); } }
                                RbSmall { icon: @image-url("icons/trash-2.svg"); label: "Supprimer"; tint: #f85149; enabled: root.att-selected >= 0 && root.can-edit; clicked => { root.act("att-del"); } }
                            }
                            if root.has-entry && root.att-rows.length == 0: Text { text: root.att-info; color: Theme.muted; font-size: 12px; }
                            for a[i] in root.att-rows: Rectangle {
                                height: 26px;
                                background: i == root.att-selected ? Theme.selection : att-ta.has-hover ? Theme.bg-hover : transparent;
                                accessible-role: list-item;
                                accessible-label: a.name;
                                accessible-item-selected: i == root.att-selected;
                                accessible-action-default => { root.att-selected = i; }
                                att-ta := TouchArea {
                                    clicked => { root.att-selected = i; }
                                    double-clicked => { root.att-selected = i; root.act("att-get"); }
                                }
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    spacing: 10px;
                                    Ico { source: @image-url("icons/paperclip.svg"); tint: Theme.muted; y: 6px; }
                                    Text { text: a.name; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; color: Theme.text; }
                                    Text { text: a.detail; vertical-alignment: center; color: Theme.muted; font-size: 12px; }
                                    Text { text: a.extra; vertical-alignment: center; color: Theme.muted; font-size: 12px; width: 130px; }
                                }
                            }
                        }
                    }
                }
            }
            }
        }

        // Status bar (.statusbar)
        Rectangle {
            height: 24px;
            background: Theme.accent;
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 10px;
                Text { text: root.user-label == "" ? "Non connecté" : "Connecté : " + root.user-label; color: white; font-size: 12px; vertical-alignment: center; }
                SbSep { y: 5px; }
                Text { text: root.status-counts; color: white; font-size: 12px; vertical-alignment: center; }
                SbSep { y: 5px; }
                Text { text: root.tabs.length + " session(s) ouverte(s)"; color: white; font-size: 12px; vertical-alignment: center; }
                SbSep { y: 5px; }
                Text { text: (root.busy ? "⏳ " : "") + root.status; color: #ffffffcc; font-size: 12px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                if root.status-path != "": Text { text: root.status-path; color: #ffffffcc; font-size: 12px; vertical-alignment: center; overflow: elide; max-width: 260px; }
                SbSep { y: 5px; }
                Text { text: "Relay Desktop " + root.version; color: white; font-size: 12px; vertical-alignment: center; }
            }
        }
    }
    }

    if root.dialog == "notes": Dialog {
        title: "Notes de l'entrée";
        error: root.dialog-error;
        busy: root.busy;
        ok-text: "Enregistrer";
        card-width: 760px;
        ok => { root.submit-dialog(); }
        cancel => { root.cancel-dialog(); }
        Text { text: "Markdown : # titre, **gras**, *italique*, `code`, listes - ou 1., [lien](https://…), blocs ``` et tableaux."; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
        TextEdit { text <=> root.notes-text; wrap: word-wrap; height: 360px; font-size: 13px; }
    }

    if root.dialog == "cmd": Dialog {
        title: "Exécuter une commande SSH";
        error: root.dialog-error;
        busy: root.cmd-running;
        ok-text: "Exécuter";
        cancel-text: "Fermer";
        card-width: 1000px;
        ok => { root.act("cmd-run"); }
        cancel => { root.cancel-dialog(); }
        Text { text: root.cmd-targets-text; color: Theme.muted; font-size: 12px; overflow: elide; }
        HorizontalLayout {
            spacing: 8px;
            ComboBox {
                horizontal-stretch: 1;
                model: root.cmd-saved-names;
                current-index <=> root.cmd-saved-index;
                selected => { root.act("cmd-pick"); }
            }
            LineEdit { text <=> root.cmd-name; placeholder-text: "Nom pour l'enregistrer"; horizontal-stretch: 1; }
            Button { text: "Enregistrer"; enabled: root.cmd-text != "" && root.cmd-name != ""; clicked => { root.act("cmd-save"); } }
            Button { text: "Supprimer"; enabled: root.cmd-saved-index > 0; clicked => { root.act("cmd-forget"); } }
        }
        TextEdit { text <=> root.cmd-text; height: 70px; font-size: 13px; wrap: word-wrap; }
        HorizontalLayout {
            spacing: 12px;
            CheckBox { text: "sudo (mot de passe de l'identifiant)"; checked <=> root.cmd-sudo; }
            Text { text: "Délai par serveur (s)"; vertical-alignment: center; color: Theme.muted; }
            LineEdit { text <=> root.cmd-timeout; width: 70px; input-type: number; }
            Rectangle { horizontal-stretch: 1; }
            Button { text: "Arrêter"; enabled: root.cmd-running; clicked => { root.act("cmd-stop"); } }
            Button { text: "Relancer les échecs"; enabled: !root.cmd-running && root.cmd-retryable; clicked => { root.act("cmd-retry"); } }
        }
        Text { text: root.cmd-summary; color: Theme.text; font-size: 12px; }
        HorizontalLayout {
            spacing: 8px;
            Rectangle {
                width: 430px;
                height: 300px;
                border-width: 1px;
                border-color: Theme.border;
                border-radius: 4px;
                ListView {
                    for r[i] in root.cmd-rows: Rectangle {
                        height: 26px;
                        background: i == root.cmd-selected ? Theme.selection : cmd-ta.has-hover ? Theme.bg-hover : transparent;
                        accessible-role: list-item;
                        accessible-label: r.name + " " + r.extra;
                        accessible-item-selected: i == root.cmd-selected;
                        accessible-action-default => { root.cmd-selected = i; root.act("cmd-show"); }
                        cmd-ta := TouchArea { clicked => { root.cmd-selected = i; root.act("cmd-show"); } }
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 8px;
                            StatusDot { status: r.status; y: 9px; }
                            Text { text: r.name; width: 150px; vertical-alignment: center; overflow: elide; color: Theme.text; }
                            Text { text: r.detail; width: 120px; vertical-alignment: center; overflow: elide; color: Theme.muted; font-size: 12px; }
                            Text { text: r.extra; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; color: r.status == 2 ? #f85149 : Theme.muted; font-size: 12px; }
                        }
                    }
                }
            }
            TextEdit { text: root.cmd-output; read-only: true; height: 300px; horizontal-stretch: 1; font-size: 12px; wrap: word-wrap; }
        }
    }

    if root.dialog == "backup": Dialog {
        title: "Sauvegarde et restauration";
        error: root.dialog-error;
        busy: root.busy;
        show-ok: false;
        cancel-text: "Fermer";
        card-width: 560px;
        cancel => { root.cancel-dialog(); }
        Text {
            text: root.server-mode
                ? "Archive chiffrée de tout le serveur Relay (entrées, identifiants, réglages, enregistrements), protégée par un mot de passe de sauvegarde."
                : "Copie chiffrée du fichier du coffre local, protégée par un mot de passe de sauvegarde. Le mot de passe maître reste celui du coffre d'origine.";
            wrap: word-wrap;
            color: Theme.muted;
            font-size: 12px;
        }
        Text { text: "Exporter"; font-weight: 600; color: Theme.text; }
        HorizontalLayout {
            spacing: 8px;
            LineEdit { text <=> root.bk-password; input-type: password; placeholder-text: "Mot de passe de sauvegarde"; }
            LineEdit { text <=> root.bk-password2; input-type: password; placeholder-text: "Confirmation"; }
            Button { text: "Exporter…"; primary: true; enabled: !root.busy && root.bk-password != ""; clicked => { root.act("bk-export"); } }
        }
        Text { text: "Restaurer"; font-weight: 600; color: Theme.text; }
        Text {
            text: root.server-mode
                ? "Remplace tout le contenu du serveur par celui de l'archive. Fermez d'abord les sessions."
                : "Déchiffre la copie dans un nouveau fichier, à ajouter ensuite comme source.";
            wrap: word-wrap;
            color: Theme.muted;
            font-size: 12px;
        }
        HorizontalLayout {
            spacing: 8px;
            LineEdit { text <=> root.bk-restore-password; input-type: password; placeholder-text: "Mot de passe de la sauvegarde"; }
            Button { text: "Restaurer…"; enabled: !root.busy && root.bk-restore-password != ""; clicked => { root.act("bk-restore"); } }
        }
    }

    if root.dialog == "admin": Dialog {
        title: root.adm-title;
        error: root.dialog-error;
        busy: root.busy;
        show-ok: false;
        cancel-text: "Fermer";
        card-width: 900px;
        cancel => { root.cancel-dialog(); }
        if root.adm-hint != "": Text { text: root.adm-hint; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
        Rectangle {
            height: 320px;
            border-width: 1px;
            border-color: Theme.border;
            border-radius: 4px;
            ListView {
                for r[i] in root.adm-rows: Rectangle {
                    height: 26px;
                    background: i == root.adm-selected ? Theme.selection : adm-ta.has-hover ? Theme.bg-hover : transparent;
                    accessible-role: list-item;
                    accessible-label: r.name;
                    accessible-item-selected: i == root.adm-selected;
                    accessible-action-default => { root.adm-selected = i; root.act("adm-select"); }
                    adm-ta := TouchArea { clicked => { root.adm-selected = i; root.act("adm-select"); } }
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 10px;
                        StatusDot { status: r.status; y: 9px; }
                        Text { text: r.name; width: 280px; vertical-alignment: center; overflow: elide; color: Theme.text; }
                        Text { text: r.detail; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; color: Theme.muted; font-size: 12px; }
                        Text { text: r.extra; width: 230px; vertical-alignment: center; overflow: elide; color: r.status == 2 ? #f85149 : Theme.muted; font-size: 12px; }
                    }
                }
            }
        }
        if root.adm-detail != "": Text { text: root.adm-detail; color: Theme.text; wrap: word-wrap; font-size: 12px; }
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            for a[i] in root.adm-actions: Button {
                text: a.label;
                enabled: !root.busy && (!a.needs-selection || (root.adm-selected >= 0 && root.adm-selected < root.adm-rows.length));
                clicked => { root.act("adm-" + i); }
            }
        }
    }

    if root.dialog == "import": Dialog {
        title: "Importer depuis Remote Desktop Manager";
        error: root.dialog-error;
        busy: root.busy;
        ok-text: "Importer";
        card-width: 900px;
        ok => { root.act("imp-apply"); }
        cancel => { root.cancel-dialog(); }
        Text { text: "Exportez depuis RDM (Fichier → Exporter → Exporter tout au format .rdm), puis choisissez le fichier. Les mots de passe chiffrés par RDM ne sont pas relisibles et devront être ressaisis."; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
        HorizontalLayout {
            spacing: 8px;
            LineEdit { text <=> root.imp-path; placeholder-text: "Fichier .rdm"; horizontal-stretch: 1; }
            Button { text: "Parcourir…"; clicked => { root.act("imp-browse"); } }
            Button { text: "Analyser"; enabled: root.imp-path != "" && !root.busy; clicked => { root.act("imp-preview"); } }
        }
        HorizontalLayout {
            spacing: 8px;
            FormRow { label: "Dossier racine créé"; LineEdit { text <=> root.imp-root; } }
            FormRow { label: "Identifiant par défaut (SSH)"; ComboBox { model: root.imp-cred-names; current-index <=> root.imp-ssh; } }
            FormRow { label: "Identifiant par défaut (RDP)"; ComboBox { model: root.imp-cred-names; current-index <=> root.imp-rdp; } }
        }
        if root.imp-summary != "": Text { text: root.imp-summary; color: Theme.text; wrap: word-wrap; font-size: 12px; }
        Rectangle {
            height: 260px;
            border-width: 1px;
            border-color: Theme.border;
            border-radius: 4px;
            ListView {
                for r in root.imp-rows: HorizontalLayout {
                    height: 24px;
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 10px;
                    StatusDot { status: r.status; y: 8px; }
                    Text { text: r.name; width: 240px; vertical-alignment: center; overflow: elide; color: Theme.text; font-size: 12px; }
                    Text { text: r.detail; width: 260px; vertical-alignment: center; overflow: elide; color: Theme.muted; font-size: 12px; }
                    Text { text: r.extra; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; color: r.status == 2 ? #d29922 : Theme.muted; font-size: 12px; }
                }
            }
        }
    }

    if root.dialog == "quick": Dialog {
        title: "Connexion rapide";
        error: root.dialog-error;
        busy: root.busy;
        ok-text: "Connecter";
        card-width: 480px;
        ok => { root.submit-dialog(); }
        cancel => { root.cancel-dialog(); }
        HorizontalLayout {
            spacing: 10px;
            FormRow { label: "Protocole"; horizontal-stretch: 1; ComboBox { model: ["RDP", "SSH", "Web"]; current-index <=> root.q-kind; } }
            FormRow { label: "Hôte ou URL"; horizontal-stretch: 3; LineEdit { text <=> root.q-host; placeholder-text: "serveur.lan, 10.0.0.5 ou https://…"; } }
            FormRow { label: "Port"; horizontal-stretch: 1; LineEdit { text <=> root.q-port; placeholder-text: "défaut"; } }
        }
        FormRow { label: "Identifiant du coffre"; ComboBox { model: root.credential-names; current-index <=> root.q-cred; } }
        if root.q-cred == 0: HorizontalLayout {
            spacing: 10px;
            FormRow { label: "Utilisateur"; horizontal-stretch: 1; LineEdit { text <=> root.q-username; } }
            FormRow { label: "Mot de passe"; horizontal-stretch: 1; LineEdit { text <=> root.q-password; input-type: password; accepted => { root.submit-dialog(); } } }
        }
    }

    if root.dialog == "creds": Dialog {
        title: "Identifiants du coffre";
        error: root.dialog-error;
        busy: root.busy;
        show-ok: false;
        cancel-text: "Fermer";
        card-width: 760px;
        cancel => { root.cancel-dialog(); }
        HorizontalLayout {
            spacing: 8px;
            Button { text: "Nouveau"; clicked => { root.act("cred-new"); } }
            Button { text: "Modifier"; enabled: root.cred-selected >= 0; clicked => { root.act("cred-edit"); } }
            Button { text: "Copier le mot de passe"; enabled: root.cred-selected >= 0; clicked => { root.act("cred-copy"); } }
            Button { text: "Code TOTP"; enabled: root.cred-selected >= 0; clicked => { root.act("cred-totp"); } }
            Button { text: "Supprimer"; enabled: root.cred-selected >= 0; clicked => { root.act("cred-del"); } }
        }
        Rectangle {
            height: 300px;
            border-width: 1px;
            border-color: Theme.border;
            border-radius: 4px;
            ListView {
                for c[i] in root.cred-rows: Rectangle {
                    height: 30px;
                    background: i == root.cred-selected ? Theme.selection : cta.has-hover ? Theme.bg-hover : transparent;
                    accessible-role: list-item;
                    accessible-label: c.name;
                    accessible-action-default => { root.cred-selected = i; root.cred-selected-changed(i); }
                    cta := TouchArea { clicked => { root.cred-selected = i; root.cred-selected-changed(i); } }
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 10px;
                        KindIcon { kind: "credential"; y: 7px; }
                        Text { text: c.name; width: 220px; vertical-alignment: center; overflow: elide; color: Theme.text; }
                        Text { text: c.username; width: 200px; vertical-alignment: center; overflow: elide; color: Theme.muted; }
                        Text { text: c.detail; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; color: Theme.muted; font-size: 11px; }
                    }
                }
            }
        }
        if root.cred-info != "": Text { text: root.cred-info; color: Theme.text; wrap: word-wrap; }
    }

    if root.dialog == "folder-creds": Dialog {
        title: "Identifiants du dossier";
        error: root.dialog-error;
        busy: root.busy;
        ok-text: "Enregistrer";
        card-width: 480px;
        ok => { root.submit-dialog(); }
        cancel => { root.cancel-dialog(); }
        Text { text: "Les entrées du dossier et de ses sous-dossiers utilisent ces comptes par défaut. Un identifiant choisi sur une entrée reste prioritaire."; wrap: word-wrap; color: Theme.muted; font-size: 12px; }
        FormRow { label: "RDP"; ComboBox { model: root.credential-names; current-index <=> root.fc-rdp; } }
        FormRow { label: "SSH"; ComboBox { model: root.credential-names; current-index <=> root.fc-ssh; } }
        FormRow { label: "VNC"; ComboBox { model: root.credential-names; current-index <=> root.fc-vnc; } }
        FormRow { label: "Web"; ComboBox { model: root.credential-names; current-index <=> root.fc-web; } }
    }

    if root.dialog == "test": Dialog {
        title: "Tester la connexion";
        error: root.dialog-error;
        busy: root.busy;
        ok-text: "Relancer";
        cancel-text: "Fermer";
        card-width: 480px;
        ok => { root.act("test-connection"); }
        cancel => { root.cancel-dialog(); }
        Text { text: root.busy ? "Test en cours…" : root.test-text; wrap: word-wrap; color: Theme.text; }
    }

    if root.dialog == "availability": Dialog {
        title: "Disponibilité";
        error: root.dialog-error;
        busy: root.busy;
        ok-text: "Retester";
        cancel-text: "Fermer";
        card-width: 980px;
        ok => { root.act("availability-run"); }
        cancel => { root.cancel-dialog(); }
        CheckBox { text: "Afficher uniquement les ports inaccessibles"; checked <=> root.avail-failed-only; toggled => { root.act("availability-filter"); } }
        Rectangle {
            height: 380px;
            border-width: 1px;
            border-color: Theme.border;
            border-radius: 4px;
            ListView {
                for a in root.avail-rows: HorizontalLayout {
                    height: 26px;
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 10px;
                    StatusDot { status: a.status; y: 9px; }
                    KindIcon { kind: a.kind; y: 5px; }
                    Text { text: a.name; width: 200px; vertical-alignment: center; overflow: elide; color: Theme.text; }
                    Text { text: a.endpoint; width: 200px; vertical-alignment: center; overflow: elide; color: Theme.muted; }
                    Text { text: a.path; width: 200px; vertical-alignment: center; overflow: elide; color: Theme.muted; font-size: 11px; }
                    Text { text: a.detail; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; color: a.status == 2 ? #f85149 : Theme.muted; font-size: 12px; }
                }
            }
        }
    }

    if root.dialog == "audit": Dialog {
        title: "Journal d'activité";
        error: root.dialog-error;
        busy: root.busy;
        show-ok: false;
        cancel-text: "Fermer";
        card-width: 980px;
        cancel => { root.cancel-dialog(); }
        Rectangle {
            height: 420px;
            border-width: 1px;
            border-color: Theme.border;
            border-radius: 4px;
            ListView {
                for a in root.audit-rows: HorizontalLayout {
                    height: 24px;
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 10px;
                    Text { text: a.at; width: 140px; vertical-alignment: center; color: Theme.muted; font-size: 12px; }
                    Text { text: a.user; width: 180px; vertical-alignment: center; overflow: elide; color: Theme.text; font-size: 12px; }
                    Text { text: a.action; width: 150px; vertical-alignment: center; overflow: elide; color: #58a6ff; font-size: 12px; }
                    Text { text: a.target; width: 200px; vertical-alignment: center; overflow: elide; color: Theme.text; font-size: 12px; }
                    Text { text: a.detail; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; color: Theme.muted; font-size: 12px; }
                }
            }
        }
    }

    if root.dialog == "workspaces": Dialog {
        title: "Espaces de travail";
        error: root.dialog-error;
        busy: root.busy;
        show-ok: false;
        cancel-text: "Fermer";
        card-width: 600px;
        cancel => { root.cancel-dialog(); }
        Text { text: "Un espace de travail rouvre en un clic un groupe de sessions."; color: Theme.muted; font-size: 12px; }
        Rectangle {
            height: 220px;
            border-width: 1px;
            border-color: Theme.border;
            border-radius: 4px;
            ListView {
                for w[i] in root.ws-rows: Rectangle {
                    height: 30px;
                    background: i == root.ws-selected ? Theme.selection : wta.has-hover ? Theme.bg-hover : transparent;
                    accessible-role: list-item;
                    accessible-label: w.name;
                    accessible-action-default => { root.ws-selected = i; }
                    wta := TouchArea {
                        clicked => { root.ws-selected = i; }
                        double-clicked => { root.ws-selected = i; root.act("ws-open"); }
                    }
                    HorizontalLayout {
                        padding-left: 10px;
                        spacing: 10px;
                        Ico { source: @image-url("icons/folder-open.svg"); tint: #e3b341; y: 7px; }
                        Text { text: w.name; vertical-alignment: center; horizontal-stretch: 1; color: Theme.text; }
                        Text { text: w.detail; vertical-alignment: center; color: Theme.muted; font-size: 12px; }
                    }
                }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            Button { text: "Ouvrir"; primary: true; enabled: root.ws-selected >= 0; clicked => { root.act("ws-open"); } }
            Button { text: "Supprimer"; enabled: root.ws-selected >= 0; clicked => { root.act("ws-del"); } }
        }
        HorizontalLayout {
            spacing: 8px;
            LineEdit { text <=> root.ws-name; placeholder-text: "Nom du nouvel espace"; horizontal-stretch: 1; }
            Button { text: "Enregistrer les sessions ouvertes"; enabled: root.tabs.length > 0; clicked => { root.act("ws-save"); } }
        }
    }

    if root.dialog == "about": Dialog {
        title: "À propos de Relay Desktop";
        show-ok: false;
        cancel-text: "Fermer";
        card-width: 460px;
        cancel => { root.cancel-dialog(); }
        HorizontalLayout {
            spacing: 14px;
            Image { source: @image-url("icon.png"); width: 56px; height: 56px; }
            VerticalLayout {
                alignment: center;
                Text { text: "Relay Desktop " + root.version; font-size: 16px; font-weight: 600; color: Theme.text; }
                Text { text: "Gestionnaire de connexions à distance"; color: Theme.muted; }
            }
        }
        Text { text: "Client Windows natif de Relay (Rust, Slint). Licence Apache 2.0. Icônes Lucide (licence ISC)."; wrap: word-wrap; color: Theme.text; }
    }

    if root.dialog == "source": Dialog {
        title: "Ajouter une source de données";
        error: root.dialog-error;
        busy: root.busy;
        ok-text: "Ajouter";
        ok => { root.submit-dialog(); }
        cancel => { root.cancel-dialog(); }
        FormRow {
            label: "Type";
            ComboBox { model: ["Serveur Relay", "Base locale (sans serveur)"]; current-index <=> root.src-type; }
        }
        FormRow {
            label: "Nom affiché";
            LineEdit { text <=> root.src-name; placeholder-text: root.src-type == 0 ? "Relay maison" : "Mes serveurs"; }
        }
        if root.src-type == 0: FormRow {
            label: "Serveur ou lien d'appairage relay://pair?…";
            LineEdit { text <=> root.src-url; placeholder-text: "https://relay.example.com"; }
        }
        if root.src-type == 0: FormRow {
            label: "Jeton d'appareil (Relay web → Administration → Appareils)";
            LineEdit { text <=> root.src-token; input-type: password; placeholder-text: "rlt_…"; }
        }
        if root.src-type == 1: CheckBox { text: "Créer une nouvelle base"; checked <=> root.src-create; }
        if root.src-type == 1: FormRow {
            label: "Fichier de la base";
            HorizontalLayout {
                spacing: 6px;
                LineEdit { text <=> root.src-path; horizontal-stretch: 1; }
                Button { text: "Parcourir…"; clicked => { root.browse-path(); } }
            }
        }
        if root.src-type == 1: FormRow {
            label: "Mot de passe maître";
            LineEdit { text <=> root.src-password; input-type: password; }
        }
        if root.src-type == 1 && root.src-create: FormRow {
            label: "Confirmation";
            LineEdit { text <=> root.src-password2; input-type: password; }
        }
        if root.src-type == 1 && root.src-create: Text {
            text: "Le mot de passe maître chiffre les identifiants. Il ne peut pas être récupéré s'il est perdu.";
            wrap: word-wrap;
            font-size: 11px;
            color: Theme.muted;
        }
    }

    if root.dialog == "unlock": Dialog {
        title: "Déverrouiller « " + root.unlock-name + " »";
        error: root.dialog-error;
        busy: root.busy;
        ok-text: "Déverrouiller";
        card-width: 420px;
        ok => { root.submit-dialog(); }
        cancel => { root.cancel-dialog(); }
        FormRow {
            label: "Mot de passe maître";
            pw := LineEdit {
                text <=> root.unlock-password;
                input-type: password;
                accepted => { root.submit-dialog(); }
            }
        }
    }



    if root.dialog == "sync-src": Dialog {
        title: root.ss-title;
        error: root.dialog-error;
        busy: root.busy;
        ok-text: "Enregistrer";
        card-width: 560px;
        ok => { root.submit-dialog(); }
        cancel => { root.cancel-dialog(); }
        HorizontalLayout {
            spacing: 10px;
            FormRow { label: "Nom"; horizontal-stretch: 2; LineEdit { text <=> root.ss-name; } }
            FormRow { label: "Type"; horizontal-stretch: 1; ComboBox { model: ["Proxmox VE", "NetBox"]; current-index <=> root.ss-kind; } }
        }
        FormRow { label: "URL"; LineEdit { text <=> root.ss-url; placeholder-text: root.ss-kind == 0 ? "https://pve.lan:8006" : "https://netbox.lan"; } }
        if root.ss-kind == 0: FormRow { label: "Identifiant du jeton (utilisateur@royaume!jeton)"; LineEdit { text <=> root.ss-token-id; placeholder-text: "relay@pve!sync"; } }
        FormRow {
            label: root.ss-has-secret ? "Secret du jeton (laisser vide pour conserver l'actuel)" : (root.ss-kind == 0 ? "Secret du jeton (UUID)" : "Jeton d'API NetBox");
            LineEdit { text <=> root.ss-secret; input-type: password; }
        }
        HorizontalLayout {
            spacing: 10px;
            FormRow { label: "Synchronisation automatique (minutes, 0 = manuelle)"; horizontal-stretch: 1; LineEdit { text <=> root.ss-interval; input-type: number; placeholder-text: "0"; } }
            VerticalLayout { alignment: end; CheckBox { text: "Vérifier le certificat TLS"; checked <=> root.ss-verify-tls; } }
        }
        HorizontalLayout {
            spacing: 10px;
            FormRow { label: "Identifiant des entrées SSH"; horizontal-stretch: 1; ComboBox { model: root.ss-cred-names; current-index <=> root.ss-ssh-cred; } }
            FormRow { label: "Identifiant des entrées RDP"; horizontal-stretch: 1; ComboBox { model: root.ss-cred-names; current-index <=> root.ss-rdp-cred; } }
        }
        CheckBox { text: root.ss-kind == 0 ? "Entrées des invités (VM et conteneurs : SSH / RDP)" : "Équipements"; checked <=> root.ss-opt-a; }
        CheckBox { text: root.ss-kind == 0 ? "Entrées des nœuds (SSH et interface web)" : "Machines virtuelles"; checked <=> root.ss-opt-b; }
    }
    if root.dialog == "options": Dialog {
        title: "Options";
        error: root.dialog-error;
        ok-text: "Enregistrer";
        card-width: 520px;
        ok => { root.submit-dialog(); }
        cancel => { root.cancel-dialog(); }
        Text { text: "Général"; font-weight: 600; color: Theme.text; }
        FormRow { label: "Thème"; ComboBox { model: ["Sombre", "Clair"]; current-index <=> root.o-theme; } }
        CheckBox { text: "Rechercher les mises à jour au démarrage (une fois par jour)"; checked <=> root.o-auto-update; }
        Text { text: "Terminal SSH (par défaut, chaque entrée peut le changer)"; font-weight: 600; color: Theme.text; }
        HorizontalLayout {
            spacing: 10px;
            FormRow { label: "Police"; horizontal-stretch: 2; ComboBox { model: ["Consolas", "Cascadia Mono", "Lucida Console", "Courier New"]; current-index <=> root.o-font; } }
            FormRow { label: "Taille (6 à 48)"; horizontal-stretch: 1; LineEdit { text <=> root.o-font-size; input-type: number; placeholder-text: "14"; } }
        }
        CheckBox { text: "Copier automatiquement le texte sélectionné (comme PuTTY)"; checked <=> root.o-copy-select; }
        HorizontalLayout {
            spacing: 10px;
            FormRow { label: "Thème de couleurs"; horizontal-stretch: 1; ComboBox { model: root.term-theme-names; current-index <=> root.o-term-theme; } }
            VerticalLayout { alignment: end; CheckBox { text: "Gras = couleurs vives"; checked <=> root.o-bold-bright; } }
        }
        HorizontalLayout {
            spacing: 10px;
            CheckBox { text: "Coloration syntaxique (erreurs, avertissements, adresses…)"; checked <=> root.o-highlight; horizontal-stretch: 1; }
            Button { text: "Règles…"; clicked => { root.act("hl-rules"); } }
        }
        Text { text: "Sessions RDP (par défaut)"; font-weight: 600; color: Theme.text; }
        HorizontalLayout {
            spacing: 10px;
            FormRow { label: "Résolution"; horizontal-stretch: 2; ComboBox { model: ["Adapter à l'onglet", "Taille fixe", "Plein écran"]; current-index <=> root.o-rdp-res; } }
            if root.o-rdp-res == 1: FormRow { label: "Largeur"; horizontal-stretch: 1; LineEdit { min-width: 64px; text <=> root.o-rdp-width; input-type: number; placeholder-text: "1920"; } }
            if root.o-rdp-res == 1: FormRow { label: "Hauteur"; horizontal-stretch: 1; LineEdit { min-width: 64px; text <=> root.o-rdp-height; input-type: number; placeholder-text: "1080"; } }
        }
    }
    if root.dialog == "entry": Dialog {
        title: root.e-title;
        error: root.dialog-error;
        busy: root.busy;
        ok-text: "Enregistrer";
        card-width: 640px;
        ok => { root.submit-dialog(); }
        cancel => { root.cancel-dialog(); }
        if root.e-kind <= 2: HorizontalLayout {
            spacing: 6px;
            alignment: start;
            Button { text: "Général"; primary: root.e-section == 0; clicked => { root.e-section = 0; } }
            Button { text: root.e-kind == 0 ? "Connexion RDP" : root.e-kind == 1 ? "Terminal SSH" : "Paramètres VNC"; primary: root.e-section == 1; clicked => { root.e-section = 1; } }
        }
        if root.e-section == 1 && root.e-kind == 0: VerticalLayout {
            spacing: 10px;
            HorizontalLayout {
                spacing: 10px;
                FormRow { label: "Résolution"; horizontal-stretch: 2; ComboBox { model: root.rdp-res-names; current-index <=> root.er-res; } }
                if root.er-res == 2: FormRow { label: "Largeur"; horizontal-stretch: 1; LineEdit { min-width: 64px; text <=> root.er-width; input-type: number; placeholder-text: "1920"; } }
                if root.er-res == 2: FormRow { label: "Hauteur"; horizontal-stretch: 1; LineEdit { min-width: 64px; text <=> root.er-height; input-type: number; placeholder-text: "1080"; } }
                FormRow { label: "Couleurs"; horizontal-stretch: 1; ComboBox { model: ["Par défaut (32 bits)", "15 bits", "16 bits", "24 bits", "32 bits"]; current-index <=> root.er-depth; } }
            }
            HorizontalLayout {
                spacing: 10px;
                FormRow { label: "Son"; horizontal-stretch: 1; ComboBox { model: ["Sur ce poste", "Sur l'ordinateur distant", "Désactivé"]; current-index <=> root.er-audio; } }
                FormRow { label: "Touches Windows (Alt+Tab…)"; horizontal-stretch: 1; ComboBox { model: ["En plein écran", "Sur l'ordinateur distant", "Sur ce poste"]; current-index <=> root.er-keys; } }
                FormRow { label: "Sécurité"; horizontal-stretch: 1; ComboBox { model: ["Automatique", "NLA", "TLS", "RDP"]; current-index <=> root.er-security; } }
            }
            HorizontalLayout {
                spacing: 10px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 4px;
                    CheckBox { text: "Copier depuis la session"; checked <=> root.er-copy; }
                    CheckBox { text: "Coller dans la session"; checked <=> root.er-paste; }
                    CheckBox { text: "Lecteurs locaux"; checked <=> root.er-drives; }
                    CheckBox { text: "Imprimantes"; checked <=> root.er-printers; }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 4px;
                    CheckBox { text: "Session d'administration (console)"; checked <=> root.er-console; }
                    CheckBox { text: "Multi-écran (plein écran)"; checked <=> root.er-multimon; enabled: root.er-res == 3 || root.er-res == 0; }
                    CheckBox { text: "Fond d'écran"; checked <=> root.er-wallpaper; }
                    CheckBox { text: "Ignorer les erreurs de certificat"; checked <=> root.er-ignore-cert; }
                }
            }
            HorizontalLayout {
                spacing: 10px;
                FormRow { label: "Passerelle RD"; horizontal-stretch: 1; ComboBox { model: ["Aucune", "Toujours", "Sauf adresses locales"]; current-index <=> root.er-gw; } }
                if root.er-gw > 0: FormRow { label: "Hôte de la passerelle"; horizontal-stretch: 2; LineEdit { text <=> root.er-gw-host; placeholder-text: "rdgw.exemple.fr"; } }
            }
            if root.er-gw > 0: CheckBox { text: "Mêmes identifiants pour la passerelle"; checked <=> root.er-gw-same; }
        }
        if root.e-section == 1 && root.e-kind == 1: VerticalLayout {
            spacing: 10px;
            HorizontalLayout {
                spacing: 10px;
                FormRow { label: "Police"; horizontal-stretch: 2; ComboBox { model: root.term-font-names; current-index <=> root.es-font; } }
                FormRow { label: "Taille (6 à 48)"; horizontal-stretch: 1; LineEdit { text <=> root.es-size; input-type: number; placeholder-text: "Options"; } }
            }
            HorizontalLayout {
                spacing: 10px;
                FormRow { label: "Couleurs"; horizontal-stretch: 2; ComboBox { model: ["Gris sur noir", "Vert sur noir", "Blanc sur noir", "Noir sur blanc"]; current-index <=> root.es-scheme; } }
                FormRow { label: "Historique (lignes)"; horizontal-stretch: 1; LineEdit { text <=> root.es-scrollback; input-type: number; placeholder-text: "5000"; } }
                FormRow { label: "Keepalive (s, 0 = aucun)"; horizontal-stretch: 1; LineEdit { text <=> root.es-keepalive; input-type: number; placeholder-text: "30"; } }
            }
            HorizontalLayout {
                spacing: 10px;
                FormRow { label: "Thème de couleurs"; horizontal-stretch: 1; ComboBox { model: root.es-theme-names; current-index <=> root.es-theme; } }
                FormRow { label: "Coloration syntaxique"; horizontal-stretch: 1; ComboBox { model: ["Selon les Options", "Activée", "Désactivée"]; current-index <=> root.es-highlight; } }
            }
            HorizontalLayout {
                spacing: 10px;
                FormRow { label: "Jeu de caractères distant"; horizontal-stretch: 1; ComboBox { model: root.charset-names; current-index <=> root.es-charset; } }
                VerticalLayout { alignment: end; horizontal-stretch: 1; CheckBox { text: "Envoyer LANG et LC_ALL (langue de Windows)"; checked <=> root.es-send-locale; } }
            }
            CheckBox { text: "Essayer les clés de l'agent SSH (OpenSSH pour Windows, puis Pageant)"; checked <=> root.es-agent; }
            HorizontalLayout {
                spacing: 6px;
                FormRow {
                    label: "Fichier de clé privée sur ce poste (si l'identifiant n'a pas de clé)";
                    horizontal-stretch: 1;
                    LineEdit { text <=> root.es-keyfile; placeholder-text: "C:\\Users\\…\\.ssh\\id_ed25519"; }
                }
                VerticalLayout { alignment: end; Button { text: "Parcourir…"; clicked => { root.pick-key-file(); } } }
            }
            CheckBox { text: "Transfert de fichiers (SFTP) : bouton « Fichiers » dans la session"; checked <=> root.es-sftp; }
            if root.es-sftp: FormRow { label: "Dossier de départ du navigateur de fichiers"; LineEdit { text <=> root.es-sftp-root; placeholder-text: "/"; } }
        }
        if root.e-section == 1 && root.e-kind == 2: VerticalLayout {
            spacing: 10px;
            FormRow { label: "Profondeur de couleur"; ComboBox { model: ["Automatique", "256 couleurs", "16 bits", "24 bits", "32 bits"]; current-index <=> root.ev-depth; } }
            CheckBox { text: "Lecture seule (observer sans contrôler)"; checked <=> root.ev-read-only; }
            CheckBox { text: "Curseur dessiné par le serveur"; checked <=> root.ev-remote-cursor; }
        }
        if root.e-section == 0 || root.e-kind > 2: VerticalLayout {
            spacing: 12px;
            HorizontalLayout {
                spacing: 10px;
                FormRow { label: "Nom"; horizontal-stretch: 2; LineEdit { text <=> root.e-name; } }
                FormRow { label: "Protocole"; horizontal-stretch: 1; ComboBox { model: root.kind-names; current-index <=> root.e-kind; } }
            }
            if root.e-kind != 3: HorizontalLayout {
                spacing: 10px;
                FormRow { label: "Hôte"; horizontal-stretch: 3; LineEdit { text <=> root.e-host; placeholder-text: "serveur.lan ou 10.0.0.5"; } }
                FormRow { label: "Port"; horizontal-stretch: 1; LineEdit { text <=> root.e-port; input-type: number; } }
            }
            if root.e-kind == 3: FormRow { label: "URL"; LineEdit { text <=> root.e-url; placeholder-text: "https://…"; } }
            HorizontalLayout {
                spacing: 10px;
                FormRow { label: "Utilisateur (si pas d'identifiant)"; horizontal-stretch: 1; LineEdit { text <=> root.e-username; } }
                FormRow { label: "Identifiant du coffre"; horizontal-stretch: 1; ComboBox { model: root.credential-names; current-index <=> root.e-cred; } }
            }
            FormRow { label: "Dossier"; ComboBox { model: root.folder-names; current-index <=> root.e-folder; } }
            FormRow { label: "Notes"; TextEdit { text <=> root.e-notes; height: 90px; wrap: word-wrap; } }
        }
    }

    if root.dialog == "folder": Dialog {
        title: root.f-title;
        error: root.dialog-error;
        busy: root.busy;
        ok-text: "Enregistrer";
        card-width: 440px;
        ok => { root.submit-dialog(); }
        cancel => { root.cancel-dialog(); }
        FormRow { label: "Nom"; LineEdit { text <=> root.f-name; accepted => { root.submit-dialog(); } } }
        FormRow { label: "Dossier parent"; ComboBox { model: root.folder-names; current-index <=> root.f-parent; } }
    }

    if root.dialog == "credential": Dialog {
        title: root.c-title;
        error: root.dialog-error;
        busy: root.busy;
        ok-text: "Enregistrer";
        card-width: 480px;
        ok => { root.submit-dialog(); }
        cancel => { root.cancel-dialog(); }
        HorizontalLayout {
            alignment: start;
            spacing: 6px;
            Button { text: "Général"; primary: root.c-section == 0; clicked => { root.c-section = 0; } }
            Button { text: "Clé SSH"; primary: root.c-section == 1; clicked => { root.c-section = 1; } }
        }
        if root.c-section == 0: VerticalLayout {
            spacing: 12px;
            FormRow { label: "Nom"; LineEdit { text <=> root.c-name; placeholder-text: "Admin domaine"; } }
            HorizontalLayout {
                spacing: 10px;
                FormRow { label: "Utilisateur"; horizontal-stretch: 1; LineEdit { text <=> root.c-username; } }
                FormRow { label: "Domaine"; horizontal-stretch: 1; LineEdit { text <=> root.c-domain; } }
            }
            FormRow { label: "Mot de passe (laisser vide pour ne pas le modifier)"; LineEdit { text <=> root.c-password; input-type: password; } }
            FormRow { label: "Secret TOTP (base32 ou lien otpauth://, facultatif)"; LineEdit { text <=> root.c-totp; input-type: password; } }
            FormRow { label: "Notes"; TextEdit { text <=> root.c-notes; height: 70px; wrap: word-wrap; } }
        }
        if root.c-section == 1: VerticalLayout {
            spacing: 10px;
            if root.c-has-private-key: CheckBox { text: "Retirer la clé SSH enregistrée"; checked <=> root.c-remove-key; }
            if !root.c-remove-key: VerticalLayout {
                spacing: 10px;
                FormRow {
                    label: root.c-has-private-key ? "Clé privée (laisser vide pour conserver la clé enregistrée)"
                        : root.server-mode ? "Clé privée OpenSSH ou PEM" : "Clé privée OpenSSH, PEM ou PuTTY (.ppk)";
                    TextEdit { text <=> root.c-private-key; height: 110px; wrap: word-wrap; }
                }
                HorizontalLayout {
                    alignment: start;
                    Button { text: "Importer un fichier…"; enabled: !root.busy; clicked => { root.act("cred-key-file"); } }
                }
                FormRow { label: "Phrase secrète de la clé importée (si chiffrée)"; LineEdit { text <=> root.c-passphrase; input-type: password; } }
            }
        }
    }

    if root.dialog == "update": Dialog {
        title: "Mises à jour de Relay";
        error: root.upd-state == "error" ? root.upd-message : "";
        busy: root.upd-state == "checking" || root.upd-state == "downloading";
        ok-text: "Mettre à jour";
        show-ok: root.upd-state == "available" || root.upd-state == "downloading";
        cancel-text: root.upd-state == "available" ? "Plus tard" : "Fermer";
        card-width: 520px;
        ok => { root.submit-dialog(); }
        cancel => { root.cancel-dialog(); }
        HorizontalLayout {
            spacing: 12px;
            Text { text: "Version installée"; width: 150px; color: Theme.muted; }
            Text { text: root.upd-current; color: Theme.text; }
        }
        if root.upd-latest != "": HorizontalLayout {
            spacing: 12px;
            Text { text: "Nouvelle version"; width: 150px; color: Theme.muted; }
            Text { text: root.upd-latest; font-weight: 600; color: Theme.text; }
        }
        if root.upd-state == "checking": Text { text: "Recherche de mises à jour…"; color: Theme.text; }
        if root.upd-state == "uptodate": Text { text: "Relay est à jour."; color: Theme.text; }
        if root.upd-state == "downloading": Text { text: root.upd-message; color: Theme.text; }
        if root.upd-notes != "" && (root.upd-state == "available" || root.upd-state == "downloading"): TextEdit {
            text: root.upd-notes;
            read-only: true;
            wrap: word-wrap;
            height: 140px;
        }
        if root.upd-state == "available": Text {
            text: "L'installeur s'ouvrira (droits administrateur demandés), puis Relay redémarrera. Les sessions ouvertes seront fermées.";
            wrap: word-wrap;
            font-size: 11px;
            color: Theme.muted;
        }
        CheckBox {
            text: "Rechercher les mises à jour au démarrage";
            checked <=> root.upd-auto;
            toggled => { root.update-auto-toggled(self.checked); }
        }
    }

    if root.dialog == "move": Dialog {
        title: root.move-title;
        error: root.dialog-error;
        busy: root.busy;
        ok-text: "Déplacer";
        card-width: 440px;
        ok => { root.submit-dialog(); }
        cancel => { root.cancel-dialog(); }
        FormRow { label: "Dossier de destination"; ComboBox { model: root.folder-names; current-index <=> root.move-target; } }
    }

    if root.dialog == "confirm": Dialog {
        title: "Confirmer";
        error: root.dialog-error;
        busy: root.busy;
        ok-text: root.confirm-ok != "" ? root.confirm-ok : "Supprimer";
        card-width: 420px;
        ok => { root.submit-dialog(); }
        cancel => { root.cancel-dialog(); }
        Text { text: root.confirm-text; wrap: word-wrap; }
    }
    if root.dialog == "prompt": Dialog {
        title: root.prompt-title;
        error: root.dialog-error;
        busy: root.busy;
        ok-text: root.prompt-ok != "" ? root.prompt-ok : "OK";
        card-width: 440px;
        ok => { root.submit-dialog(); }
        cancel => { root.cancel-dialog(); }
        FormRow {
            label: root.prompt-label;
            prompt-edit := LineEdit {
                text <=> root.prompt-text;
                init => { self.focus(); self.select-all(); }
                accepted => { root.submit-dialog(); }
            }
        }
    }
    if root.dialog == "hl-rules": Dialog {
        title: "Règles de coloration syntaxique";
        error: root.dialog-error;
        busy: root.busy;
        ok-text: "Enregistrer";
        card-width: 760px;
        ok => { root.submit-dialog(); }
        cancel => { root.hl-act("cancel"); }
        Text { text: "La première règle qui correspond l'emporte. Mot = mot entier ; sinon expression régulière (syntaxe Rust regex)."; wrap: word-wrap; color: Theme.muted; font-size: 12px; }
        HorizontalLayout {
            spacing: 10px;
            Rectangle {
                horizontal-stretch: 1;
                height: 200px;
                border-width: 1px;
                border-color: Theme.border;
                border-radius: 4px;
                ListView {
                    for r[i] in root.hl-rows: Rectangle {
                        height: 24px;
                        background: i == root.hl-sel ? Theme.selection : transparent;
                        accessible-role: list-item;
                        accessible-label: r.name;
                        accessible-action-default => { root.hl-sel = i; root.hl-act("select"); }
                        TouchArea { clicked => { root.hl-sel = i; root.hl-act("select"); } }
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 8px;
                            StatusDot { status: r.status; y: 8px; }
                            Text { text: r.name; horizontal-stretch: 1; vertical-alignment: center; overflow: elide; color: Theme.text; font-family: "Consolas"; font-size: 12px; }
                            Text { text: r.detail; width: 90px; vertical-alignment: center; color: Theme.muted; font-size: 12px; }
                            Text { text: r.extra; width: 120px; vertical-alignment: center; color: Theme.muted; font-size: 12px; overflow: elide; }
                        }
                    }
                }
            }
            VerticalLayout {
                spacing: 6px;
                alignment: start;
                Button { text: "Ajouter"; clicked => { root.hl-act("add"); } }
                Button { text: "Supprimer"; enabled: root.hl-sel >= 0; clicked => { root.hl-act("delete"); } }
                Button { text: "Monter"; enabled: root.hl-sel > 0; clicked => { root.hl-act("up"); } }
                Button { text: "Descendre"; enabled: root.hl-sel >= 0 && root.hl-sel < root.hl-rows.length - 1; clicked => { root.hl-act("down"); } }
                Button { text: "Règles par défaut"; clicked => { root.hl-act("defaults"); } }
            }
        }
        if root.hl-sel >= 0: VerticalLayout {
            spacing: 8px;
            FormRow { label: "Mot ou expression"; LineEdit { text <=> root.hl-pattern; edited => { root.hl-act("apply"); } } }
            HorizontalLayout {
                spacing: 10px;
                FormRow { label: "Texte"; horizontal-stretch: 1; ComboBox { model: root.hl-color-names; current-index <=> root.hl-fg; selected => { root.hl-act("apply"); } } }
                FormRow { label: "Fond"; horizontal-stretch: 1; ComboBox { model: root.hl-color-names; current-index <=> root.hl-bg; selected => { root.hl-act("apply"); } } }
            }
            HorizontalLayout {
                spacing: 14px;
                CheckBox { text: "Expression régulière"; checked <=> root.hl-regex; toggled => { root.hl-act("apply"); } }
                CheckBox { text: "Respecter la casse"; checked <=> root.hl-case; toggled => { root.hl-act("apply"); } }
                CheckBox { text: "Gras"; checked <=> root.hl-bold; toggled => { root.hl-act("apply"); } }
                CheckBox { text: "Active"; checked <=> root.hl-enabled; toggled => { root.hl-act("apply"); } }
            }
        }
    }
}
